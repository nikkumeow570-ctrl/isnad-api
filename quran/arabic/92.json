{
 "surah": 92,
 "name_arabic": "الليل",
 "name_transliteration": "Al-Lail",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ",
   "simple": "بسم الله الرحمن الرحيم والليل إذا يغشى"
  },
  {
   "ayah": 2,
   "uthmani": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
   "simple": "والنهار إذا تجلى"
  },
  {
   "ayah": 3,
   "uthmani": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
   "simple": "وما خلق الذكر والأنثى"
  },
  {
   "ayah": 4,
   "uthmani": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
   "simple": "إن سعيكم لشتى"
  },
  {
   "ayah": 5,
   "uthmani": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
   "simple": "فأما من أعطى واتقى"
  },
  {
   "ayah": 6,
   "uthmani": "وَصَدَّقَ بِٱلْحُسْنَىٰ",
   "simple": "وصدق بالحسنى"
  },
  {
   "ayah": 7,
   "uthmani": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
   "simple": "فسنيسره لليسرى"
  },
  {
   "ayah": 8,
   "uthmani": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
   "simple": "وأما من بخل واستغنى"
  },
  {
   "ayah": 9,
   "uthmani": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
   "simple": "وكذب بالحسنى"
  },
  {
   "ayah": 10,
   "uthmani": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
   "simple": "فسنيسره للعسرى"
  },
  {
   "ayah": 11,
   "uthmani": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
   "simple": "وما يغني عنه ماله إذا تردى"
  },
  {
   "ayah": 12,
   "uthmani": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
   "simple": "إن علينا للهدى"
  },
  {
   "ayah": 13,
   "uthmani": "وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ",
   "simple": "وإن لنا للآخرة والأولى"
  },
  {
   "ayah": 14,
   "uthmani": "فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ",
   "simple": "فأنذرتكم نارا تلظى"
  },
  {
   "ayah": 15,
   "uthmani": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى",
   "simple": "لا يصلاها إلا الأشقى"
  },
  {
   "ayah": 16,
   "uthmani": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ",
   "simple": "الذي كذب وتولى"
  },
  {
   "ayah": 17,
   "uthmani": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى",
   "simple": "وسيجنبها الأتقى"
  },
  {
   "ayah": 18,
   "uthmani": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ",
   "simple": "الذي يؤتي ماله يتزكى"
  },
  {
   "ayah": 19,
   "uthmani": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ",
   "simple": "وما لأحد عنده من نعمة تجزى"
  },
  {
   "ayah": 20,
   "uthmani": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",
   "simple": "إلا ابتغاء وجه ربه الأعلى"
  },
  {
   "ayah": 21,
   "uthmani": "وَلَسَوْفَ يَرْضَىٰ",
   "simple": "ولسوف يرضى"
  }
 ]
}