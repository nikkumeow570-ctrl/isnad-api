{
 "surah": 86,
 "name_arabic": "الطارق",
 "name_transliteration": "At-Taariq",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ",
   "simple": "بسم الله الرحمن الرحيم والسماء والطارق"
  },
  {
   "ayah": 2,
   "uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ",
   "simple": "وما أدراك ما الطارق"
  },
  {
   "ayah": 3,
   "uthmani": "ٱلنَّجْمُ ٱلثَّاقِبُ",
   "simple": "النجم الثاقب"
  },
  {
   "ayah": 4,
   "uthmani": "إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ",
   "simple": "إن كل نفس لما عليها حافظ"
  },
  {
   "ayah": 5,
   "uthmani": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ",
   "simple": "فلينظر الإنسان مم خلق"
  },
  {
   "ayah": 6,
   "uthmani": "خُلِقَ مِن مَّآءٍ دَافِقٍ",
   "simple": "خلق من ماء دافق"
  },
  {
   "ayah": 7,
   "uthmani": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ",
   "simple": "يخرج من بين الصلب والترائب"
  },
  {
   "ayah": 8,
   "uthmani": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ",
   "simple": "إنه على رجعه لقادر"
  },
  {
   "ayah": 9,
   "uthmani": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ",
   "simple": "يوم تبلى السرائر"
  },
  {
   "ayah": 10,
   "uthmani": "فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ",
   "simple": "فما له من قوة ولا ناصر"
  },
  {
   "ayah": 11,
   "uthmani": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ",
   "simple": "والسماء ذات الرجع"
  },
  {
   "ayah": 12,
   "uthmani": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ",
   "simple": "والأرض ذات الصدع"
  },
  {
   "ayah": 13,
   "uthmani": "إِنَّهُۥ لَقَوْلٌ فَصْلٌ",
   "simple": "إنه لقول فصل"
  },
  {
   "ayah": 14,
   "uthmani": "وَمَا هُوَ بِٱلْهَزْلِ",
   "simple": "وما هو بالهزل"
  },
  {
   "ayah": 15,
   "uthmani": "إِنَّهُمْ يَكِيدُونَ كَيْدًا",
   "simple": "إنهم يكيدون كيدا"
  },
  {
   "ayah": 16,
   "uthmani": "وَأَكِيدُ كَيْدًا",
   "simple": "وأكيد كيدا"
  },
  {
   "ayah": 17,
   "uthmani": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا",
   "simple": "فمهل الكافرين أمهلهم رويدا"
  }
 ]
}