 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ",
   "simple": "بسم الله الرحمن الرحيم عم يتساءلون"
  },
  {
   "ayah": 2,
   "uthmani": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ",
   "simple": "عن النبإ العظيم"
  },
  {
   "ayah": 3,
   "uthmani": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ",
   "simple": "الذي هم فيه مختلفون"
  },
  {
   "ayah": 4,
   "uthmani": "كَلَّا سَيَعْلَمُونَ",
   "simple": "كلا سيعلمون"
  },
  {
   "ayah": 5,
   "uthmani": "ثُمَّ كَلَّا سَيَعْلَمُونَ",
   "simple": "ثم كلا سيعلمون"
  },
  {
   "ayah": 6,
   "uthmani": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًا",
   "simple": "ألم نجعل الأرض مهادا"
  },
  {
   "ayah": 7,
   "uthmani": "وَٱلْجِبَالَ أَوْتَادًا",
   "simple": "والجبال أوتادا"
  },
  {
   "ayah": 8,
   "uthmani": "وَخَلَقْنَٰكُمْ أَزْوَٰجًا",
   "simple": "وخلقناكم أزواجا"
  },
  {
   "ayah": 9,
   "uthmani": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا",
   "simple": "وجعلنا نومكم سباتا"
  },
  {
   "ayah": 10,
   "uthmani": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا",
   "simple": "وجعلنا الليل لباسا"
  },
  {
   "ayah": 11,
   "uthmani": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا",
   "simple": "وجعلنا النهار معاشا"
  },
  {
   "ayah": 12,
   "uthmani": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا",
   "simple": "وبنينا فوقكم سبعا شدادا"
  },
  {
   "ayah": 13,
   "uthmani": "وَجَعَلْنَا سِرَاجًا وَهَّاجًا",
   "simple": "وجعلنا سراجا وهاجا"
  },
  {
   "ayah": 14,
   "uthmani": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا",
   "simple": "وأنزلنا من المعصرات ماء ثجاجا"
  },
  {
   "ayah": 15,
   "uthmani": "لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا",
   "simple": "لنخرج به حبا ونباتا"
  },
  {
   "ayah": 16,
   "uthmani": "وَجَنَّٰتٍ أَلْفَافًا",
   "simple": "وجنات ألفافا"
  },
  {
   "ayah": 17,
   "uthmani": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًا",
   "simple": "إن يوم الفصل كان ميقاتا"
  },
  {
   "ayah": 18,
   "uthmani": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا",
   "simple": "يوم ينفخ في الصور فتأتون أفواجا"
  },
  {
   "ayah": 19,
   "uthmani": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا",
   "simple": "وفتحت السماء فكانت أبوابا"
  },
  {
   "ayah": 20,
   "uthmani": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
   "simple": "وسيرت الجبال فكانت سرابا"
  },
  {
   "ayah": 21,
   "uthmani": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا",
   "simple": "إن جهنم كانت مرصادا"
  },
  {
   "ayah": 22,
   "uthmani": "لِّلطَّٰغِينَ مَـَٔابًا",
   "simple": "للطاغين مآبا"
  },
  {
   "ayah": 23,
   "uthmani": "لَّٰبِثِينَ فِيهَآ أَحْقَابًا",
   "simple": "لابثين فيها أحقابا"
  },
  {
   "ayah": 24,
   "uthmani": "لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا",
   "simple": "لا يذوقون فيها بردا ولا شرابا"
  },
  {
   "ayah": 25,
   "uthmani": "إِلَّا حَمِيمًا وَغَسَّاقًا",
   "simple": "إلا حميما وغساقا"
  },
  {
   "ayah": 26,
   "uthmani": "جَزَآءً وِفَاقًا",
   "simple": "جزاء وفاقا"
  },
  {
   "ayah": 27,
   "uthmani": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا",
   "simple": "إنهم كانوا لا يرجون حسابا"
  },
  {
   "ayah": 28,
   "uthmani": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًا",
   "simple": "وكذبوا بآياتنا كذابا"
  },
  {
   "ayah": 29,
   "uthmani": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًا",
   "simple": "وكل شيء أحصيناه كتابا"
  },
  {
   "ayah": 30,
   "uthmani": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا",
   "simple": "فذوقوا فلن نزيدكم إلا عذابا"
  },
  {
   "ayah": 31,
   "uthmani": "إِنَّ لِلْمُتَّقِينَ مَفَازًا",
   "simple": "إن للمتقين مفازا"
  },
  {
   "ayah": 32,
   "uthmani": "حَدَآئِقَ وَأَعْنَٰبًا",
   "simple": "حدائق وأعنابا"
  },
  {
   "ayah": 33,
   "uthmani": "وَكَوَاعِبَ أَتْرَابًا",
   "simple": "وكواعب أترابا"
  },
  {
   "ayah": 34,
   "uthmani": "وَكَأْسًا دِهَاقًا",
   "simple": "وكأسا دهاقا"
  },
  {
   "ayah": 35,
   "uthmani": "لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا",
   "simple": "لا يسمعون فيها لغوا ولا كذابا"
  },
  {
   "ayah": 36,
   "uthmani": "جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا",
   "simple": "جزاء من ربك عطاء حسابا"
  },
  {
   "ayah": 37,
   "uthmani": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ لَا يَمْلِكُونَ مِنْهُ خِطَابًا",
   "simple": "رب السماوات والأرض وما بينهما الرحمن لا يملكون منه خطابا"
  },
  {
   "ayah": 38,
   "uthmani": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّا لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًا",
   "simple": "يوم يقوم الروح والملائكة صفا لا يتكلمون إلا من أذن له الرحمن وقال صوابا"
  },
  {
   "ayah": 39,
   "uthmani": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",
   "simple": "ذلك اليوم الحق فمن شاء اتخذ إلى ربه مآبا"
  },
  {
   "ayah": 40,
   "uthmani": "إِنَّآ أَنذَرْنَٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا",
   "simple": "إنا أنذرناكم عذابا قريبا يوم ينظر المرء ما قدمت يداه ويقول الكافر يا ليتني كنت ترابا"
  }
 ]
}