 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ",
   "simple": "بسم الله الرحمن الرحيم ألم تر كيف فعل ربك بأصحاب الفيل"
  },
  {
   "ayah": 2,
   "uthmani": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ",
   "simple": "ألم يجعل كيدهم في تضليل"
  },
  {
   "ayah": 3,
   "uthmani": "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ",
   "simple": "وأرسل عليهم طيرا أبابيل"
  },
  {
   "ayah": 4,
   "uthmani": "تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ",
   "simple": "ترميهم بحجارة من سجيل"
  },
  {
   "ayah": 5,
   "uthmani": "فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ",
   "simple": "فجعلهم كعصف مأكول"
  }
 ]
}