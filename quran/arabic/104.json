{
 "surah": 104,
 "name_arabic": "الهمزة",
 "name_transliteration": "Al-Humaza",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ",
   "simple": "بسم الله الرحمن الرحيم ويل لكل همزة لمزة"
  },
  {
   "ayah": 2,
   "uthmani": "ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ",
   "simple": "الذي جمع مالا وعدده"
  },
  {
   "ayah": 3,
   "uthmani": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
   "simple": "يحسب أن ماله أخلده"
  },
  {
   "ayah": 4,
   "uthmani": "كَلَّا لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",
   "simple": "كلا لينبذن في الحطمة"
  },
  {
   "ayah": 5,
   "uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ",
   "simple": "وما أدراك ما الحطمة"
  },
  {
   "ayah": 6,
   "uthmani": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ",
   "simple": "نار الله الموقدة"
  },
  {
   "ayah": 7,
   "uthmani": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ",
   "simple": "التي تطلع على الأفئدة"
  },
  {
   "ayah": 8,
   "uthmani": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ",
   "simple": "إنها عليهم مؤصدة"
  },
  {
   "ayah": 9,
   "uthmani": "فِى عَمَدٍ مُّمَدَّدَةٍۭ",
   "simple": "في عمد ممددة"
  }
 ]
}