{
 "surah": 81,
 "name_arabic": "التكوير",
 "name_transliteration": "At-Takwir",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ",
   "simple": "بسم الله الرحمن الرحيم إذا الشمس كورت"
  },
  {
   "ayah": 2,
   "uthmani": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
   "simple": "وإذا النجوم انكدرت"
  },
  {
   "ayah": 3,
   "uthmani": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
   "simple": "وإذا الجبال سيرت"
  },
  {
   "ayah": 4,
   "uthmani": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
   "simple": "وإذا العشار عطلت"
  },
  {
   "ayah": 5,
   "uthmani": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
   "simple": "وإذا الوحوش حشرت"
  },
  {
   "ayah": 6,
   "uthmani": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
   "simple": "وإذا البحار سجرت"
  },
  {
   "ayah": 7,
   "uthmani": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
   "simple": "وإذا النفوس زوجت"
  },
  {
   "ayah": 8,
   "uthmani": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
   "simple": "وإذا الموءودة سئلت"
  },
  {
   "ayah": 9,
   "uthmani": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
   "simple": "بأي ذنب قتلت"
  },
  {
   "ayah": 10,
   "uthmani": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
   "simple": "وإذا الصحف نشرت"
  },
  {
   "ayah": 11,
   "uthmani": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
   "simple": "وإذا السماء كشطت"
  },
  {
   "ayah": 12,
   "uthmani": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
   "simple": "وإذا الجحيم سعرت"
  },
  {
   "ayah": 13,
   "uthmani": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
   "simple": "وإذا الجنة أزلفت"
  },
  {
   "ayah": 14,
   "uthmani": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
   "simple": "علمت نفس ما أحضرت"
  },
  {
   "ayah": 15,
   "uthmani": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
   "simple": "فلا أقسم بالخنس"
  },
  {
   "ayah": 16,
   "uthmani": "ٱلْجَوَارِ ٱلْكُنَّسِ",
   "simple": "الجوار الكنس"
  },
  {
   "ayah": 17,
   "uthmani": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
   "simple": "والليل إذا عسعس"
  },
  {
   "ayah": 18,
   "uthmani": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
   "simple": "والصبح إذا تنفس"
  },
  {
   "ayah": 19,
   "uthmani": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
   "simple": "إنه لقول رسول كريم"
  },
  {
   "ayah": 20,
   "uthmani": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
   "simple": "ذي قوة عند ذي العرش مكين"
  },
  {
   "ayah": 21,
   "uthmani": "مُّطَاعٍ ثَمَّ أَمِينٍ",
   "simple": "مطاع ثم أمين"
  },
  {
   "ayah": 22,
   "uthmani": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
   "simple": "وما صاحبكم بمجنون"
  },
  {
   "ayah": 23,
   "uthmani": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
   "simple": "ولقد رآه بالأفق المبين"
  },
  {
   "ayah": 24,
   "uthmani": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
   "simple": "وما هو على الغيب بضنين"
  },
  {
   "ayah": 25,
   "uthmani": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍ رَّجِيمٍ",
   "simple": "وما هو بقول شيطان رجيم"
  },
  {
   "ayah": 26,
   "uthmani": "فَأَيْنَ تَذْهَبُونَ",
   "simple": "فأين تذهبون"
  },
  {
   "ayah": 27,
   "uthmani": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَٰلَمِينَ",
   "simple": "إن هو إلا ذكر للعالمين"
  },
  {
   "ayah": 28,
   "uthmani": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
   "simple": "لمن شاء منكم أن يستقيم"
  },
  {
   "ayah": 29,
   "uthmani": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ",
   "simple": "وما تشاءون إلا أن يشاء الله رب العالمين"
  }
 ]
}