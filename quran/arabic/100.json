{
 "surah": 100,
 "name_arabic": "العاديات",
 "name_transliteration": "Al-Aadiyaat",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًا",
   "simple": "بسم الله الرحمن الرحيم والعاديات ضبحا"
  },
  {
   "ayah": 2,
   "uthmani": "فَٱلْمُورِيَٰتِ قَدْحًا",
   "simple": "فالموريات قدحا"
  },
  {
   "ayah": 3,
   "uthmani": "فَٱلْمُغِيرَٰتِ صُبْحًا",
   "simple": "فالمغيرات صبحا"
  },
  {
   "ayah": 4,
   "uthmani": "فَأَثَرْنَ بِهِۦ نَقْعًا",
   "simple": "فأثرن به نقعا"
  },
  {
   "ayah": 5,
   "uthmani": "فَوَسَطْنَ بِهِۦ جَمْعًا",
   "simple": "فوسطن به جمعا"
  },
  {
   "ayah": 6,
   "uthmani": "إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌ",
   "simple": "إن الإنسان لربه لكنود"
  },
  {
   "ayah": 7,
   "uthmani": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ",
   "simple": "وإنه على ذلك لشهيد"
  },
  {
   "ayah": 8,
   "uthmani": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",
   "simple": "وإنه لحب الخير لشديد"
  },
  {
   "ayah": 9,
   "uthmani": "أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ",
   "simple": "أفلا يعلم إذا بعثر ما في القبور"
  },
  {
   "ayah": 10,
   "uthmani": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ",
   "simple": "وحصل ما في الصدور"
  },
  {
   "ayah": 11,
   "uthmani": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ",
   "simple": "إن ربهم بهم يومئذ لخبير"
  }
 ]
}