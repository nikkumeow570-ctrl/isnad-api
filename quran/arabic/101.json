{
 "surah": 101,
 "name_arabic": "القارعة",
 "name_transliteration": "Al-Qaari'a",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ",
   "simple": "بسم الله الرحمن الرحيم القارعة"
  },
  {
   "ayah": 2,
   "uthmani": "مَا ٱلْقَارِعَةُ",
   "simple": "ما القارعة"
  },
  {
   "ayah": 3,
   "uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ",
   "simple": "وما أدراك ما القارعة"
  },
  {
   "ayah": 4,
   "uthmani": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ",
   "simple": "يوم يكون الناس كالفراش المبثوث"
  },
  {
   "ayah": 5,
   "uthmani": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ",
   "simple": "وتكون الجبال كالعهن المنفوش"
  },
  {
   "ayah": 6,
   "uthmani": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ",
   "simple": "فأما من ثقلت موازينه"
  },
  {
   "ayah": 7,
   "uthmani": "فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ",
   "simple": "فهو في عيشة راضية"
  },
  {
   "ayah": 8,
   "uthmani": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ",
   "simple": "وأما من خفت موازينه"
  },
  {
   "ayah": 9,
   "uthmani": "فَأُمُّهُۥ هَاوِيَةٌ",
   "simple": "فأمه هاوية"
  },
  {
   "ayah": 10,
   "uthmani": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ",
   "simple": "وما أدراك ما هيه"
  },
  {
   "ayah": 11,
   "uthmani": "نَارٌ حَامِيَةٌۢ",
   "simple": "نار حامية"
  }
 ]
}