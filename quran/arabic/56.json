{
 "surah": 56,
 "name_arabic": "الواقعة",
 "name_transliteration": "Al-Waaqia",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ",
   "simple": "بسم الله الرحمن الرحيم إذا وقعت الواقعة"
  },
  {
   "ayah": 2,
   "uthmani": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ",
   "simple": "ليس لوقعتها كاذبة"
  },
  {
   "ayah": 3,
   "uthmani": "خَافِضَةٌ رَّافِعَةٌ",
   "simple": "خافضة رافعة"
  },
  {
   "ayah": 4,
   "uthmani": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا",
   "simple": "إذا رجت الأرض رجا"
  },
  {
   "ayah": 5,
   "uthmani": "وَبُسَّتِ ٱلْجِبَالُ بَسًّا",
   "simple": "وبست الجبال بسا"
  },
  {
   "ayah": 6,
   "uthmani": "فَكَانَتْ هَبَآءً مُّنۢبَثًّا",
   "simple": "فكانت هباء منبثا"
  },
  {
   "ayah": 7,
   "uthmani": "وَكُنتُمْ أَزْوَٰجًا ثَلَٰثَةً",
   "simple": "وكنتم أزواجا ثلاثة"
  },
  {
   "ayah": 8,
   "uthmani": "فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ",
   "simple": "فأصحاب الميمنة ما أصحاب الميمنة"
  },
  {
   "ayah": 9,
   "uthmani": "وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ",
   "simple": "وأصحاب المشأمة ما أصحاب المشأمة"
  },
  {
   "ayah": 10,
   "uthmani": "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ",
   "simple": "والسابقون السابقون"
  },
  {
   "ayah": 11,
   "uthmani": "أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ",
   "simple": "أولئك المقربون"
  },
  {
   "ayah": 12,
   "uthmani": "فِى جَنَّٰتِ ٱلنَّعِيمِ",
   "simple": "في جنات النعيم"
  },
  {
   "ayah": 13,
   "uthmani": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ",
   "simple": "ثلة من الأولين"
  },
  {
   "ayah": 14,
   "uthmani": "وَقَلِيلٌ مِّنَ ٱلْـَٔاخِرِينَ",
   "simple": "وقليل من الآخرين"
  },
  {
   "ayah": 15,
   "uthmani": "عَلَىٰ سُرُرٍ مَّوْضُونَةٍ",
   "simple": "على سرر موضونة"
  },
  {
   "ayah": 16,
   "uthmani": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ",
   "simple": "متكئين عليها متقابلين"
  },
  {
   "ayah": 17,
   "uthmani": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ",
   "simple": "يطوف عليهم ولدان مخلدون"
  },
  {
   "ayah": 18,
   "uthmani": "بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ",
   "simple": "بأكواب وأباريق وكأس من معين"
  },
  {
   "ayah": 19,
   "uthmani": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ",
   "simple": "لا يصدعون عنها ولا ينزفون"
  },
  {
   "ayah": 20,
   "uthmani": "وَفَٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ",
   "simple": "وفاكهة مما يتخيرون"
  },
  {
   "ayah": 21,
   "uthmani": "وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ",
   "simple": "ولحم طير مما يشتهون"
  },
  {
   "ayah": 22,
   "uthmani": "وَحُورٌ عِينٌ",
   "simple": "وحور عين"
  },
  {
   "ayah": 23,
   "uthmani": "كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ",
   "simple": "كأمثال اللؤلؤ المكنون"
  },
  {
   "ayah": 24,
   "uthmani": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ",
   "simple": "جزاء بما كانوا يعملون"
  },
  {
   "ayah": 25,
   "uthmani": "لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا",
   "simple": "لا يسمعون فيها لغوا ولا تأثيما"
  },
  {
   "ayah": 26,
   "uthmani": "إِلَّا قِيلًا سَلَٰمًا سَلَٰمًا",
   "simple": "إلا قيلا سلاما سلاما"
  },
  {
   "ayah": 27,
   "uthmani": "وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ",
   "simple": "وأصحاب اليمين ما أصحاب اليمين"
  },
  {
   "ayah": 28,
   "uthmani": "فِى سِدْرٍ مَّخْضُودٍ",
   "simple": "في سدر مخضود"
  },
  {
   "ayah": 29,
   "uthmani": "وَطَلْحٍ مَّنضُودٍ",
   "simple": "وطلح منضود"
  },
  {
   "ayah": 30,
   "uthmani": "وَظِلٍّ مَّمْدُودٍ",
   "simple": "وظل ممدود"
  },
  {
   "ayah": 31,
   "uthmani": "وَمَآءٍ مَّسْكُوبٍ",
   "simple": "وماء مسكوب"
  },
  {
   "ayah": 32,
   "uthmani": "وَفَٰكِهَةٍ كَثِيرَةٍ",
   "simple": "وفاكهة كثيرة"
  },
  {
   "ayah": 33,
   "uthmani": "لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ",
   "simple": "لا مقطوعة ولا ممنوعة"
  },
  {
   "ayah": 34,
   "uthmani": "وَفُرُشٍ مَّرْفُوعَةٍ",
   "simple": "وفرش مرفوعة"
  },
  {
   "ayah": 35,
   "uthmani": "إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءً",
   "simple": "إنا أنشأناهن إنشاء"
  },
  {
   "ayah": 36,
   "uthmani": "فَجَعَلْنَٰهُنَّ أَبْكَارًا",
   "simple": "فجعلناهن أبكارا"
  },
  {
   "ayah": 37,
   "uthmani": "عُرُبًا أَتْرَابًا",
   "simple": "عربا أترابا"
  },
  {
   "ayah": 38,
   "uthmani": "لِّأَصْحَٰبِ ٱلْيَمِينِ",
   "simple": "لأصحاب اليمين"
  },
  {
   "ayah": 39,
   "uthmani": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ",
   "simple": "ثلة من الأولين"
  },
  {
   "ayah": 40,
   "uthmani": "وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ",
   "simple": "وثلة من الآخرين"
  },
  {
   "ayah": 41,
   "uthmani": "وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ",
   "simple": "وأصحاب الشمال ما أصحاب الشمال"
  },
  {
   "ayah": 42,
   "uthmani": "فِى سَمُومٍ وَحَمِيمٍ",
   "simple": "في سموم وحميم"
  },
  {
   "ayah": 43,
   "uthmani": "وَظِلٍّ مِّن يَحْمُومٍ",
   "simple": "وظل من يحموم"
  },
  {
   "ayah": 44,
   "uthmani": "لَّا بَارِدٍ وَلَا كَرِيمٍ",
   "simple": "لا بارد ولا كريم"
  },
  {
   "ayah": 45,
   "uthmani": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ",
   "simple": "إنهم كانوا قبل ذلك مترفين"
  },
  {
   "ayah": 46,
   "uthmani": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ",
   "simple": "وكانوا يصرون على الحنث العظيم"
  },
  {
   "ayah": 47,
   "uthmani": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ",
   "simple": "وكانوا يقولون أئذا متنا وكنا ترابا وعظاما أإنا لمبعوثون"
  },
  {
   "ayah": 48,
   "uthmani": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ",
   "simple": "أوآباؤنا الأولون"
  },
  {
   "ayah": 49,
   "uthmani": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ",
   "simple": "قل إن الأولين والآخرين"
  },
  {
   "ayah": 50,
   "uthmani": "لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍ مَّعْلُومٍ",
   "simple": "لمجموعون إلى ميقات يوم معلوم"
  },
  {
   "ayah": 51,
   "uthmani": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ",
   "simple": "ثم إنكم أيها الضالون المكذبون"
  },
  {
   "ayah": 52,
   "uthmani": "لَـَٔاكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ",
   "simple": "لآكلون من شجر من زقوم"
  },
  {
   "ayah": 53,
   "uthmani": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ",
   "simple": "فمالئون منها البطون"
  },
  {
   "ayah": 54,
   "uthmani": "فَشَٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ",
   "simple": "فشاربون عليه من الحميم"
  },
  {
   "ayah": 55,
   "uthmani": "فَشَٰرِبُونَ شُرْبَ ٱلْهِيمِ",
   "simple": "فشاربون شرب الهيم"
  },
  {
   "ayah": 56,
   "uthmani": "هَٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ",
   "simple": "هذا نزلهم يوم الدين"
  },
  {
   "ayah": 57,
   "uthmani": "نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَ",
   "simple": "نحن خلقناكم فلولا تصدقون"
  },
  {
   "ayah": 58,
   "uthmani": "أَفَرَءَيْتُم مَّا تُمْنُونَ",
   "simple": "أفرأيتم ما تمنون"
  },
  {
   "ayah": 59,
   "uthmani": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَٰلِقُونَ",
   "simple": "أأنتم تخلقونه أم نحن الخالقون"
  },
  {
   "ayah": 60,
   "uthmani": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ",
   "simple": "نحن قدرنا بينكم الموت وما نحن بمسبوقين"
  },
  {
   "ayah": 61,
   "uthmani": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ",
   "simple": "على أن نبدل أمثالكم وننشئكم في ما لا تعلمون"
  },
  {
   "ayah": 62,
   "uthmani": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ",
   "simple": "ولقد علمتم النشأة الأولى فلولا تذكرون"
  },
  {
   "ayah": 63,
   "uthmani": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ",
   "simple": "أفرأيتم ما تحرثون"
  },
  {
   "ayah": 64,
   "uthmani": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ",
   "simple": "أأنتم تزرعونه أم نحن الزارعون"
  },
  {
   "ayah": 65,
   "uthmani": "لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰمًا فَظَلْتُمْ تَفَكَّهُونَ",
   "simple": "لو نشاء لجعلناه حطاما فظلتم تفكهون"
  },
  {
   "ayah": 66,
   "uthmani": "إِنَّا لَمُغْرَمُونَ",
   "simple": "إنا لمغرمون"
  },
  {
   "ayah": 67,
   "uthmani": "بَلْ نَحْنُ مَحْرُومُونَ",
   "simple": "بل نحن محرومون"
  },
  {
   "ayah": 68,
   "uthmani": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ",
   "simple": "أفرأيتم الماء الذي تشربون"
  },
  {
   "ayah": 69,
   "uthmani": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ",
   "simple": "أأنتم أنزلتموه من المزن أم نحن المنزلون"
  },
  {
   "ayah": 70,
   "uthmani": "لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ",
   "simple": "لو نشاء جعلناه أجاجا فلولا تشكرون"
  },
  {
   "ayah": 71,
   "uthmani": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ",
   "simple": "أفرأيتم النار التي تورون"
  },
  {
   "ayah": 72,
   "uthmani": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ",
   "simple": "أأنتم أنشأتم شجرتها أم نحن المنشئون"
  },
  {
   "ayah": 73,
   "uthmani": "نَحْنُ جَعَلْنَٰهَا تَذْكِرَةً وَمَتَٰعًا لِّلْمُقْوِينَ",
   "simple": "نحن جعلناها تذكرة ومتاعا للمقوين"
  },
  {
   "ayah": 74,
   "uthmani": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
   "simple": "فسبح باسم ربك العظيم"
  },
  {
   "ayah": 75,
   "uthmani": "فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ",
   "simple": "فلا أقسم بمواقع النجوم"
  },
  {
   "ayah": 76,
   "uthmani": "وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ",
   "simple": "وإنه لقسم لو تعلمون عظيم"
  },
  {
   "ayah": 77,
   "uthmani": "إِنَّهُۥ لَقُرْءَانٌ كَرِيمٌ",
   "simple": "إنه لقرآن كريم"
  },
  {
   "ayah": 78,
   "uthmani": "فِى كِتَٰبٍ مَّكْنُونٍ",
   "simple": "في كتاب مكنون"
  },
  {
   "ayah": 79,
   "uthmani": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ",
   "simple": "لا يمسه إلا المطهرون"
  },
  {
   "ayah": 80,
   "uthmani": "تَنزِيلٌ مِّن رَّبِّ ٱلْعَٰلَمِينَ",
   "simple": "تنزيل من رب العالمين"
  },
  {
   "ayah": 81,
   "uthmani": "أَفَبِهَٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ",
   "simple": "أفبهذا الحديث أنتم مدهنون"
  },
  {
   "ayah": 82,
   "uthmani": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ",
   "simple": "وتجعلون رزقكم أنكم تكذبون"
  },
  {
   "ayah": 83,
   "uthmani": "فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ",
   "simple": "فلولا إذا بلغت الحلقوم"
  },
  {
   "ayah": 84,
   "uthmani": "وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ",
   "simple": "وأنتم حينئذ تنظرون"
  },
  {
   "ayah": 85,
   "uthmani": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ",
