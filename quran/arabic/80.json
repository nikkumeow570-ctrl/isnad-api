{
 "surah": 80,
 "name_arabic": "عبس",
 "name_transliteration": "Abasa",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ",
   "simple": "بسم الله الرحمن الرحيم عبس وتولى"
  },
  {
   "ayah": 2,
   "uthmani": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
   "simple": "أن جاءه الأعمى"
  },
  {
   "ayah": 3,
   "uthmani": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
   "simple": "وما يدريك لعله يزكى"
  },
  {
   "ayah": 4,
   "uthmani": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
   "simple": "أو يذكر فتنفعه الذكرى"
  },
  {
   "ayah": 5,
   "uthmani": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
   "simple": "أما من استغنى"
  },
  {
   "ayah": 6,
   "uthmani": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
   "simple": "فأنت له تصدى"
  },
  {
   "ayah": 7,
   "uthmani": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
   "simple": "وما عليك ألا يزكى"
  },
  {
   "ayah": 8,
   "uthmani": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
   "simple": "وأما من جاءك يسعى"
  },
  {
   "ayah": 9,
   "uthmani": "وَهُوَ يَخْشَىٰ",
   "simple": "وهو يخشى"
  },
  {
   "ayah": 10,
   "uthmani": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
   "simple": "فأنت عنه تلهى"
  },
  {
   "ayah": 11,
   "uthmani": "كَلَّآ إِنَّهَا تَذْكِرَةٌ",
   "simple": "كلا إنها تذكرة"
  },
  {
   "ayah": 12,
   "uthmani": "فَمَن شَآءَ ذَكَرَهُۥ",
   "simple": "فمن شاء ذكره"
  },
  {
   "ayah": 13,
   "uthmani": "فِى صُحُفٍ مُّكَرَّمَةٍ",
   "simple": "في صحف مكرمة"
  },
  {
   "ayah": 14,
   "uthmani": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ",
   "simple": "مرفوعة مطهرة"
  },
  {
   "ayah": 15,
   "uthmani": "بِأَيْدِى سَفَرَةٍ",
   "simple": "بأيدي سفرة"
  },
  {
   "ayah": 16,
   "uthmani": "كِرَامٍۭ بَرَرَةٍ",
   "simple": "كرام بررة"
  },
  {
   "ayah": 17,
   "uthmani": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ",
   "simple": "قتل الإنسان ما أكفره"
  },
  {
   "ayah": 18,
   "uthmani": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
   "simple": "من أي شيء خلقه"
  },
  {
   "ayah": 19,
   "uthmani": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
   "simple": "من نطفة خلقه فقدره"
  },
  {
   "ayah": 20,
   "uthmani": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
   "simple": "ثم السبيل يسره"
  },
  {
   "ayah": 21,
   "uthmani": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
   "simple": "ثم أماته فأقبره"
  },
  {
   "ayah": 22,
   "uthmani": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
   "simple": "ثم إذا شاء أنشره"
  },
  {
   "ayah": 23,
   "uthmani": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
   "simple": "كلا لما يقض ما أمره"
  },
  {
   "ayah": 24,
   "uthmani": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ",
   "simple": "فلينظر الإنسان إلى طعامه"
  },
  {
   "ayah": 25,
   "uthmani": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا",
   "simple": "أنا صببنا الماء صبا"
  },
  {
   "ayah": 26,
   "uthmani": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا",
   "simple": "ثم شققنا الأرض شقا"
  },
  {
   "ayah": 27,
   "uthmani": "فَأَنۢبَتْنَا فِيهَا حَبًّا",
   "simple": "فأنبتنا فيها حبا"
  },
  {
   "ayah": 28,
   "uthmani": "وَعِنَبًا وَقَضْبًا",
   "simple": "وعنبا وقضبا"
  },
  {
   "ayah": 29,
   "uthmani": "وَزَيْتُونًا وَنَخْلًا",
   "simple": "وزيتونا ونخلا"
  },
  {
   "ayah": 30,
   "uthmani": "وَحَدَآئِقَ غُلْبًا",
   "simple": "وحدائق غلبا"
  },
  {
   "ayah": 31,
   "uthmani": "وَفَٰكِهَةً وَأَبًّا",
   "simple": "وفاكهة وأبا"
  },
  {
   "ayah": 32,
   "uthmani": "مَّتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ",
   "simple": "متاعا لكم ولأنعامكم"
  },
  {
   "ayah": 33,
   "uthmani": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
   "simple": "فإذا جاءت الصاخة"
  },
  {
   "ayah": 34,
   "uthmani": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
   "simple": "يوم يفر المرء من أخيه"
  },
  {
   "ayah": 35,
   "uthmani": "وَأُمِّهِۦ وَأَبِيهِ",
   "simple": "وأمه وأبيه"
  },
  {
   "ayah": 36,
   "uthmani": "وَصَٰحِبَتِهِۦ وَبَنِيهِ",
   "simple": "وصاحبته وبنيه"
  },
  {
   "ayah": 37,
   "uthmani": "لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ",
   "simple": "لكل امرئ منهم يومئذ شأن يغنيه"
  },
  {
   "ayah": 38,
   "uthmani": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ",
   "simple": "وجوه يومئذ مسفرة"
  },
  {
   "ayah": 39,
   "uthmani": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ",
   "simple": "ضاحكة مستبشرة"
  },
  {
   "ayah": 40,
   "uthmani": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ",
   "simple": "ووجوه يومئذ عليها غبرة"
  },
  {
   "ayah": 41,
   "uthmani": "تَرْهَقُهَا قَتَرَةٌ",
   "simple": "ترهقها قترة"
  },
  {
   "ayah": 42,
   "uthmani": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",
   "simple": "أولئك هم الكفرة الفجرة"
  }
 ]
}