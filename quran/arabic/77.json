{
 "surah": 77,
 "name_arabic": "المرسلات",
 "name_transliteration": "Al-Mursalaat",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًا",
   "simple": "بسم الله الرحمن الرحيم والمرسلات عرفا"
  },
  {
   "ayah": 2,
   "uthmani": "فَٱلْعَٰصِفَٰتِ عَصْفًا",
   "simple": "فالعاصفات عصفا"
  },
  {
   "ayah": 3,
   "uthmani": "وَٱلنَّٰشِرَٰتِ نَشْرًا",
   "simple": "والناشرات نشرا"
  },
  {
   "ayah": 4,
   "uthmani": "فَٱلْفَٰرِقَٰتِ فَرْقًا",
   "simple": "فالفارقات فرقا"
  },
  {
   "ayah": 5,
   "uthmani": "فَٱلْمُلْقِيَٰتِ ذِكْرًا",
   "simple": "فالملقيات ذكرا"
  },
  {
   "ayah": 6,
   "uthmani": "عُذْرًا أَوْ نُذْرًا",
   "simple": "عذرا أو نذرا"
  },
  {
   "ayah": 7,
   "uthmani": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ",
   "simple": "إنما توعدون لواقع"
  },
  {
   "ayah": 8,
   "uthmani": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ",
   "simple": "فإذا النجوم طمست"
  },
  {
   "ayah": 9,
   "uthmani": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ",
   "simple": "وإذا السماء فرجت"
  },
  {
   "ayah": 10,
   "uthmani": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ",
   "simple": "وإذا الجبال نسفت"
  },
  {
   "ayah": 11,
   "uthmani": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ",
   "simple": "وإذا الرسل أقتت"
  },
  {
   "ayah": 12,
   "uthmani": "لِأَىِّ يَوْمٍ أُجِّلَتْ",
   "simple": "لأي يوم أجلت"
  },
  {
   "ayah": 13,
   "uthmani": "لِيَوْمِ ٱلْفَصْلِ",
   "simple": "ليوم الفصل"
  },
  {
   "ayah": 14,
   "uthmani": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ",
   "simple": "وما أدراك ما يوم الفصل"
  },
  {
   "ayah": 15,
   "uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
   "simple": "ويل يومئذ للمكذبين"
  },
  {
   "ayah": 16,
   "uthmani": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ",
   "simple": "ألم نهلك الأولين"
  },
  {
   "ayah": 17,
   "uthmani": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ",
   "simple": "ثم نتبعهم الآخرين"
  },
  {
   "ayah": 18,
   "uthmani": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
   "simple": "كذلك نفعل بالمجرمين"
  },
  {
   "ayah": 19,
   "uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
   "simple": "ويل يومئذ للمكذبين"
  },
  {
   "ayah": 20,
   "uthmani": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ",
   "simple": "ألم نخلقكم من ماء مهين"
  },
  {
   "ayah": 21,
   "uthmani": "فَجَعَلْنَٰهُ فِى قَرَارٍ مَّكِينٍ",
   "simple": "فجعلناه في قرار مكين"
  },
  {
   "ayah": 22,
   "uthmani": "إِلَىٰ قَدَرٍ مَّعْلُومٍ",
   "simple": "إلى قدر معلوم"
  },
  {
   "ayah": 23,
   "uthmani": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ",
   "simple": "فقدرنا فنعم القادرون"
  },
  {
   "ayah": 24,
   "uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
   "simple": "ويل يومئذ للمكذبين"
  },
  {
   "ayah": 25,
   "uthmani": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",
   "simple": "ألم نجعل الأرض كفاتا"
  },
  {
   "ayah": 26,
   "uthmani": "أَحْيَآءً وَأَمْوَٰتًا",
   "simple": "أحياء وأمواتا"
  },
  {
   "ayah": 27,
   "uthmani": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍ وَأَسْقَيْنَٰكُم مَّآءً فُرَاتًا",
   "simple": "وجعلنا فيها رواسي شامخات وأسقيناكم ماء فراتا"
  },
  {
   "ayah": 28,
   "uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
   "simple": "ويل يومئذ للمكذبين"
  },
  {
   "ayah": 29,
   "uthmani": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
   "simple": "انطلقوا إلى ما كنتم به تكذبون"
  },
  {
   "ayah": 30,
   "uthmani": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَٰثِ شُعَبٍ",
   "simple": "انطلقوا إلى ظل ذي ثلاث شعب"
  },
  {
   "ayah": 31,
   "uthmani": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ",
   "simple": "لا ظليل ولا يغني من اللهب"
  },
  {
   "ayah": 32,
   "uthmani": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ",
   "simple": "إنها ترمي بشرر كالقصر"
  },
  {
   "ayah": 33,
   "uthmani": "كَأَنَّهُۥ جِمَٰلَتٌ صُفْرٌ",
   "simple": "كأنه جمالت صفر"
  },
  {
   "ayah": 34,
   "uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
   "simple": "ويل يومئذ للمكذبين"
  },
  {
   "ayah": 35,
   "uthmani": "هَٰذَا يَوْمُ لَا يَنطِقُونَ",
   "simple": "هذا يوم لا ينطقون"
  },
  {
   "ayah": 36,
   "uthmani": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ",
   "simple": "ولا يؤذن لهم فيعتذرون"
  },
  {
   "ayah": 37,
   "uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
   "simple": "ويل يومئذ للمكذبين"
  },
  {
   "ayah": 38,
   "uthmani": "هَٰذَا يَوْمُ ٱلْفَصْلِ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ",
   "simple": "هذا يوم الفصل جمعناكم والأولين"
  },
  {
   "ayah": 39,
   "uthmani": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ",
   "simple": "فإن كان لكم كيد فكيدون"
  },
  {
   "ayah": 40,
   "uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
   "simple": "ويل يومئذ للمكذبين"
  },
  {
   "ayah": 41,
   "uthmani": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍ وَعُيُونٍ",
   "simple": "إن المتقين في ظلال وعيون"
  },
  {
   "ayah": 42,
   "uthmani": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ",
   "simple": "وفواكه مما يشتهون"
  },
  {
   "ayah": 43,
   "uthmani": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ",
   "simple": "كلوا واشربوا هنيئا بما كنتم تعملون"
  },
  {
   "ayah": 44,
   "uthmani": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
   "simple": "إنا كذلك نجزي المحسنين"
  },
  {
   "ayah": 45,
   "uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
   "simple": "ويل يومئذ للمكذبين"
  },
  {
   "ayah": 46,
   "uthmani": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ",
   "simple": "كلوا وتمتعوا قليلا إنكم مجرمون"
  },
  {
   "ayah": 47,
   "uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
   "simple": "ويل يومئذ للمكذبين"
  },
  {
   "ayah": 48,
   "uthmani": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ",
   "simple": "وإذا قيل لهم اركعوا لا يركعون"
  },
  {
   "ayah": 49,
   "uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
   "simple": "ويل يومئذ للمكذبين"
  },
  {
   "ayah": 50,
   "uthmani": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ",
   "simple": "فبأي حديث بعده يؤمنون"
  }
 ]
}