{
 "surah": 89,
 "name_arabic": "الفجر",
 "name_transliteration": "Al-Fajr",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ",
   "simple": "بسم الله الرحمن الرحيم والفجر"
  },
  {
   "ayah": 2,
   "uthmani": "وَلَيَالٍ عَشْرٍ",
   "simple": "وليال عشر"
  },
  {
   "ayah": 3,
   "uthmani": "وَٱلشَّفْعِ وَٱلْوَتْرِ",
   "simple": "والشفع والوتر"
  },
  {
   "ayah": 4,
   "uthmani": "وَٱلَّيْلِ إِذَا يَسْرِ",
   "simple": "والليل إذا يسر"
  },
  {
   "ayah": 5,
   "uthmani": "هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ",
   "simple": "هل في ذلك قسم لذي حجر"
  },
  {
   "ayah": 6,
   "uthmani": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ",
   "simple": "ألم تر كيف فعل ربك بعاد"
  },
  {
   "ayah": 7,
   "uthmani": "إِرَمَ ذَاتِ ٱلْعِمَادِ",
   "simple": "إرم ذات العماد"
  },
  {
   "ayah": 8,
   "uthmani": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ",
   "simple": "التي لم يخلق مثلها في البلاد"
  },
  {
   "ayah": 9,
   "uthmani": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ",
   "simple": "وثمود الذين جابوا الصخر بالواد"
  },
  {
   "ayah": 10,
   "uthmani": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ",
   "simple": "وفرعون ذي الأوتاد"
  },
  {
   "ayah": 11,
   "uthmani": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ",
   "simple": "الذين طغوا في البلاد"
  },
  {
   "ayah": 12,
   "uthmani": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ",
   "simple": "فأكثروا فيها الفساد"
  },
  {
   "ayah": 13,
   "uthmani": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ",
   "simple": "فصب عليهم ربك سوط عذاب"
  },
  {
   "ayah": 14,
   "uthmani": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ",
   "simple": "إن ربك لبالمرصاد"
  },
  {
   "ayah": 15,
   "uthmani": "فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ",
   "simple": "فأما الإنسان إذا ما ابتلاه ربه فأكرمه ونعمه فيقول ربي أكرمن"
  },
  {
   "ayah": 16,
   "uthmani": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ",
   "simple": "وأما إذا ما ابتلاه فقدر عليه رزقه فيقول ربي أهانن"
  },
  {
   "ayah": 17,
   "uthmani": "كَلَّا بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ",
   "simple": "كلا بل لا تكرمون اليتيم"
  },
  {
   "ayah": 18,
   "uthmani": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
   "simple": "ولا تحاضون على طعام المسكين"
  },
  {
   "ayah": 19,
   "uthmani": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا",
   "simple": "وتأكلون التراث أكلا لما"
  },
  {
   "ayah": 20,
   "uthmani": "وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا",
   "simple": "وتحبون المال حبا جما"
  },
  {
   "ayah": 21,
   "uthmani": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا",
   "simple": "كلا إذا دكت الأرض دكا دكا"
  },
  {
   "ayah": 22,
   "uthmani": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا",
   "simple": "وجاء ربك والملك صفا صفا"
  },
  {
   "ayah": 23,
   "uthmani": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ",
   "simple": "وجيء يومئذ بجهنم يومئذ يتذكر الإنسان وأنى له الذكرى"
  },
  {
   "ayah": 24,
   "uthmani": "يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى",
   "simple": "يقول يا ليتني قدمت لحياتي"
  },
  {
   "ayah": 25,
   "uthmani": "فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ",
   "simple": "فيومئذ لا يعذب عذابه أحد"
  },
  {
   "ayah": 26,
   "uthmani": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ",
   "simple": "ولا يوثق وثاقه أحد"
  },
  {
   "ayah": 27,
   "uthmani": "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ",
   "simple": "يا أيتها النفس المطمئنة"
  },
  {
   "ayah": 28,
   "uthmani": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً",
   "simple": "ارجعي إلى ربك راضية مرضية"
  },
  {
   "ayah": 29,
   "uthmani": "فَٱدْخُلِى فِى عِبَٰدِى",
   "simple": "فادخلي في عبادي"
  },
  {
   "ayah": 30,
   "uthmani": "وَٱدْخُلِى جَنَّتِى",
   "simple": "وادخلي جنتي"
  }
 ]
}