{
 "surah": 91,
 "name_arabic": "الشمس",
 "name_transliteration": "Ash-Shams",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا",
   "simple": "بسم الله الرحمن الرحيم والشمس وضحاها"
  },
  {
   "ayah": 2,
   "uthmani": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا",
   "simple": "والقمر إذا تلاها"
  },
  {
   "ayah": 3,
   "uthmani": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
   "simple": "والنهار إذا جلاها"
  },
  {
   "ayah": 4,
   "uthmani": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",
   "simple": "والليل إذا يغشاها"
  },
  {
   "ayah": 5,
   "uthmani": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
   "simple": "والسماء وما بناها"
  },
  {
   "ayah": 6,
   "uthmani": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا",
   "simple": "والأرض وما طحاها"
  },
  {
   "ayah": 7,
   "uthmani": "وَنَفْسٍ وَمَا سَوَّىٰهَا",
   "simple": "ونفس وما سواها"
  },
  {
   "ayah": 8,
   "uthmani": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",
   "simple": "فألهمها فجورها وتقواها"
  },
  {
   "ayah": 9,
   "uthmani": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
   "simple": "قد أفلح من زكاها"
  },
  {
   "ayah": 10,
   "uthmani": "وَقَدْ خَابَ مَن دَسَّىٰهَا",
   "simple": "وقد خاب من دساها"
  },
  {
   "ayah": 11,
   "uthmani": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",
   "simple": "كذبت ثمود بطغواها"
  },
  {
   "ayah": 12,
   "uthmani": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",
   "simple": "إذ انبعث أشقاها"
  },
  {
   "ayah": 13,
   "uthmani": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا",
   "simple": "فقال لهم رسول الله ناقة الله وسقياها"
  },
  {
   "ayah": 14,
   "uthmani": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",
   "simple": "فكذبوه فعقروها فدمدم عليهم ربهم بذنبهم فسواها"
  },
  {
   "ayah": 15,
   "uthmani": "وَلَا يَخَافُ عُقْبَٰهَا",
   "simple": "ولا يخاف عقباها"
  }
 ]
}