{
 "surah": 88,
 "name_arabic": "الغاشية",
 "name_transliteration": "Al-Ghaashiya",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ",
   "simple": "بسم الله الرحمن الرحيم هل أتاك حديث الغاشية"
  },
  {
   "ayah": 2,
   "uthmani": "وُجُوهٌ يَوْمَئِذٍ خَٰشِعَةٌ",
   "simple": "وجوه يومئذ خاشعة"
  },
  {
   "ayah": 3,
   "uthmani": "عَامِلَةٌ نَّاصِبَةٌ",
   "simple": "عاملة ناصبة"
  },
  {
   "ayah": 4,
   "uthmani": "تَصْلَىٰ نَارًا حَامِيَةً",
   "simple": "تصلى نارا حامية"
  },
  {
   "ayah": 5,
   "uthmani": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ",
   "simple": "تسقى من عين آنية"
  },
  {
   "ayah": 6,
   "uthmani": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",
   "simple": "ليس لهم طعام إلا من ضريع"
  },
  {
   "ayah": 7,
   "uthmani": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ",
   "simple": "لا يسمن ولا يغني من جوع"
  },
  {
   "ayah": 8,
   "uthmani": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",
   "simple": "وجوه يومئذ ناعمة"
  },
  {
   "ayah": 9,
   "uthmani": "لِّسَعْيِهَا رَاضِيَةٌ",
   "simple": "لسعيها راضية"
  },
  {
   "ayah": 10,
   "uthmani": "فِى جَنَّةٍ عَالِيَةٍ",
   "simple": "في جنة عالية"
  },
  {
   "ayah": 11,
   "uthmani": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةً",
   "simple": "لا تسمع فيها لاغية"
  },
  {
   "ayah": 12,
   "uthmani": "فِيهَا عَيْنٌ جَارِيَةٌ",
   "simple": "فيها عين جارية"
  },
  {
   "ayah": 13,
   "uthmani": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ",
   "simple": "فيها سرر مرفوعة"
  },
  {
   "ayah": 14,
   "uthmani": "وَأَكْوَابٌ مَّوْضُوعَةٌ",
   "simple": "وأكواب موضوعة"
  },
  {
   "ayah": 15,
   "uthmani": "وَنَمَارِقُ مَصْفُوفَةٌ",
   "simple": "ونمارق مصفوفة"
  },
  {
   "ayah": 16,
   "uthmani": "وَزَرَابِىُّ مَبْثُوثَةٌ",
   "simple": "وزرابي مبثوثة"
  },
  {
   "ayah": 17,
   "uthmani": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
   "simple": "أفلا ينظرون إلى الإبل كيف خلقت"
  },
  {
   "ayah": 18,
   "uthmani": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
   "simple": "وإلى السماء كيف رفعت"
  },
  {
   "ayah": 19,
   "uthmani": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
   "simple": "وإلى الجبال كيف نصبت"
  },
  {
   "ayah": 20,
   "uthmani": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
   "simple": "وإلى الأرض كيف سطحت"
  },
  {
   "ayah": 21,
   "uthmani": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ",
   "simple": "فذكر إنما أنت مذكر"
  },
  {
   "ayah": 22,
   "uthmani": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
   "simple": "لست عليهم بمصيطر"
  },
  {
   "ayah": 23,
   "uthmani": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
   "simple": "إلا من تولى وكفر"
  },
  {
   "ayah": 24,
   "uthmani": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",
   "simple": "فيعذبه الله العذاب الأكبر"
  },
  {
   "ayah": 25,
   "uthmani": "إِنَّ إِلَيْنَآ إِيَابَهُمْ",
   "simple": "إن إلينا إيابهم"
  },
  {
   "ayah": 26,
   "uthmani": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",
   "simple": "ثم إن علينا حسابهم"
  }
 ]
}