{
 "surah": 96,
 "name_arabic": "العلق",
 "name_transliteration": "Al-Alaq",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
   "simple": "بسم الله الرحمن الرحيم اقرأ باسم ربك الذي خلق"
  },
  {
   "ayah": 2,
   "uthmani": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ",
   "simple": "خلق الإنسان من علق"
  },
  {
   "ayah": 3,
   "uthmani": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
   "simple": "اقرأ وربك الأكرم"
  },
  {
   "ayah": 4,
   "uthmani": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
   "simple": "الذي علم بالقلم"
  },
  {
   "ayah": 5,
   "uthmani": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ",
   "simple": "علم الإنسان ما لم يعلم"
  },
  {
   "ayah": 6,
   "uthmani": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ",
   "simple": "كلا إن الإنسان ليطغى"
  },
  {
   "ayah": 7,
   "uthmani": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
   "simple": "أن رآه استغنى"
  },
  {
   "ayah": 8,
   "uthmani": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
   "simple": "إن إلى ربك الرجعى"
  },
  {
   "ayah": 9,
   "uthmani": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",
   "simple": "أرأيت الذي ينهى"
  },
  {
   "ayah": 10,
   "uthmani": "عَبْدًا إِذَا صَلَّىٰٓ",
   "simple": "عبدا إذا صلى"
  },
  {
   "ayah": 11,
   "uthmani": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",
   "simple": "أرأيت إن كان على الهدى"
  },
  {
   "ayah": 12,
   "uthmani": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",
   "simple": "أو أمر بالتقوى"
  },
  {
   "ayah": 13,
   "uthmani": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
   "simple": "أرأيت إن كذب وتولى"
  },
  {
   "ayah": 14,
   "uthmani": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
   "simple": "ألم يعلم بأن الله يرى"
  },
  {
   "ayah": 15,
   "uthmani": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
   "simple": "كلا لئن لم ينته لنسفعا بالناصية"
  },
  {
   "ayah": 16,
   "uthmani": "نَاصِيَةٍ كَٰذِبَةٍ خَاطِئَةٍ",
   "simple": "ناصية كاذبة خاطئة"
  },
  {
   "ayah": 17,
   "uthmani": "فَلْيَدْعُ نَادِيَهُۥ",
   "simple": "فليدع ناديه"
  },
  {
   "ayah": 18,
   "uthmani": "سَنَدْعُ ٱلزَّبَانِيَةَ",
   "simple": "سندع الزبانية"
  },
  {
   "ayah": 19,
   "uthmani": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب",
   "simple": "كلا لا تطعه واسجد واقترب"
  }
 ]
}