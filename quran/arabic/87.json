{
 "surah": 87,
 "name_arabic": "الأعلى",
 "name_transliteration": "Al-A'laa",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى",
   "simple": "بسم الله الرحمن الرحيم سبح اسم ربك الأعلى"
  },
  {
   "ayah": 2,
   "uthmani": "ٱلَّذِى خَلَقَ فَسَوَّىٰ",
   "simple": "الذي خلق فسوى"
  },
  {
   "ayah": 3,
   "uthmani": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ",
   "simple": "والذي قدر فهدى"
  },
  {
   "ayah": 4,
   "uthmani": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ",
   "simple": "والذي أخرج المرعى"
  },
  {
   "ayah": 5,
   "uthmani": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ",
   "simple": "فجعله غثاء أحوى"
  },
  {
   "ayah": 6,
   "uthmani": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ",
   "simple": "سنقرئك فلا تنسى"
  },
  {
   "ayah": 7,
   "uthmani": "إِلَّا مَا شَآءَ ٱللَّهُ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ",
   "simple": "إلا ما شاء الله إنه يعلم الجهر وما يخفى"
  },
  {
   "ayah": 8,
   "uthmani": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ",
   "simple": "ونيسرك لليسرى"
  },
  {
   "ayah": 9,
   "uthmani": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ",
   "simple": "فذكر إن نفعت الذكرى"
  },
  {
   "ayah": 10,
   "uthmani": "سَيَذَّكَّرُ مَن يَخْشَىٰ",
   "simple": "سيذكر من يخشى"
  },
  {
   "ayah": 11,
   "uthmani": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى",
   "simple": "ويتجنبها الأشقى"
  },
  {
   "ayah": 12,
   "uthmani": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ",
   "simple": "الذي يصلى النار الكبرى"
  },
  {
   "ayah": 13,
   "uthmani": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ",
   "simple": "ثم لا يموت فيها ولا يحيى"
  },
  {
   "ayah": 14,
   "uthmani": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ",
   "simple": "قد أفلح من تزكى"
  },
  {
   "ayah": 15,
   "uthmani": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ",
   "simple": "وذكر اسم ربه فصلى"
  },
  {
   "ayah": 16,
   "uthmani": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
   "simple": "بل تؤثرون الحياة الدنيا"
  },
  {
   "ayah": 17,
   "uthmani": "وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ",
   "simple": "والآخرة خير وأبقى"
  },
  {
   "ayah": 18,
   "uthmani": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ",
   "simple": "إن هذا لفي الصحف الأولى"
  },
  {
   "ayah": 19,
   "uthmani": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ",
   "simple": "صحف إبراهيم وموسى"
  }
 ]
}