  {
   "ayah": 4,
   "uthmani": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ",
   "simple": "من شر الوسواس الخناس"
  },
  {
   "ayah": 5,
   "uthmani": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ",
   "simple": "الذي يوسوس في صدور الناس"
