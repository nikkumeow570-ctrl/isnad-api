   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
   "simple": "بسم الله الرحمن الرحيم قل أعوذ برب الناس"
  },
  {
   "ayah": 2,
   "uthmani": "مَلِكِ ٱلنَّاسِ",
   "simple": "ملك الناس"
  },
  {
