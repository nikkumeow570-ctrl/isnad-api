{
 "surah": 75,
 "name_arabic": "القيامة",
 "name_transliteration": "Al-Qiyaama",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ",
   "simple": "بسم الله الرحمن الرحيم لا أقسم بيوم القيامة"
  },
  {
   "ayah": 2,
   "uthmani": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ",
   "simple": "ولا أقسم بالنفس اللوامة"
  },
  {
   "ayah": 3,
   "uthmani": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
   "simple": "أيحسب الإنسان ألن نجمع عظامه"
  },
  {
   "ayah": 4,
   "uthmani": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ",
   "simple": "بلى قادرين على أن نسوي بنانه"
  },
  {
   "ayah": 5,
   "uthmani": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ",
   "simple": "بل يريد الإنسان ليفجر أمامه"
  },
  {
   "ayah": 6,
   "uthmani": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ",
   "simple": "يسأل أيان يوم القيامة"
  },
  {
   "ayah": 7,
   "uthmani": "فَإِذَا بَرِقَ ٱلْبَصَرُ",
   "simple": "فإذا برق البصر"
  },
  {
   "ayah": 8,
   "uthmani": "وَخَسَفَ ٱلْقَمَرُ",
   "simple": "وخسف القمر"
  },
  {
   "ayah": 9,
   "uthmani": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ",
   "simple": "وجمع الشمس والقمر"
  },
  {
   "ayah": 10,
   "uthmani": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ",
   "simple": "يقول الإنسان يومئذ أين المفر"
  },
  {
   "ayah": 11,
   "uthmani": "كَلَّا لَا وَزَرَ",
   "simple": "كلا لا وزر"
  },
  {
   "ayah": 12,
   "uthmani": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ",
   "simple": "إلى ربك يومئذ المستقر"
  },
  {
   "ayah": 13,
   "uthmani": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ",
   "simple": "ينبأ الإنسان يومئذ بما قدم وأخر"
  },
  {
   "ayah": 14,
   "uthmani": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ",
   "simple": "بل الإنسان على نفسه بصيرة"
  },
  {
   "ayah": 15,
   "uthmani": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ",
   "simple": "ولو ألقى معاذيره"
  },
  {
   "ayah": 16,
   "uthmani": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
   "simple": "لا تحرك به لسانك لتعجل به"
  },
  {
   "ayah": 17,
   "uthmani": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
   "simple": "إن علينا جمعه وقرآنه"
  },
  {
   "ayah": 18,
   "uthmani": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
   "simple": "فإذا قرأناه فاتبع قرآنه"
  },
  {
   "ayah": 19,
   "uthmani": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ",
   "simple": "ثم إن علينا بيانه"
  },
  {
   "ayah": 20,
   "uthmani": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ",
   "simple": "كلا بل تحبون العاجلة"
  },
  {
   "ayah": 21,
   "uthmani": "وَتَذَرُونَ ٱلْـَٔاخِرَةَ",
   "simple": "وتذرون الآخرة"
  },
  {
   "ayah": 22,
   "uthmani": "وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ",
   "simple": "وجوه يومئذ ناضرة"
  },
  {
   "ayah": 23,
   "uthmani": "إِلَىٰ رَبِّهَا نَاظِرَةٌ",
   "simple": "إلى ربها ناظرة"
  },
  {
   "ayah": 24,
   "uthmani": "وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ",
   "simple": "ووجوه يومئذ باسرة"
  },
  {
   "ayah": 25,
   "uthmani": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ",
   "simple": "تظن أن يفعل بها فاقرة"
  },
  {
   "ayah": 26,
   "uthmani": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ",
   "simple": "كلا إذا بلغت التراقي"
  },
  {
   "ayah": 27,
   "uthmani": "وَقِيلَ مَنْ رَاقٍ",
   "simple": "وقيل من راق"
  },
  {
   "ayah": 28,
   "uthmani": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ",
   "simple": "وظن أنه الفراق"
  },
  {
   "ayah": 29,
   "uthmani": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ",
   "simple": "والتفت الساق بالساق"
  },
  {
   "ayah": 30,
   "uthmani": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ",
   "simple": "إلى ربك يومئذ المساق"
  },
  {
   "ayah": 31,
   "uthmani": "فَلَا صَدَّقَ وَلَا صَلَّىٰ",
   "simple": "فلا صدق ولا صلى"
  },
  {
   "ayah": 32,
   "uthmani": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ",
   "simple": "ولكن كذب وتولى"
  },
  {
   "ayah": 33,
   "uthmani": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ",
   "simple": "ثم ذهب إلى أهله يتمطى"
  },
  {
   "ayah": 34,
   "uthmani": "أَوْلَىٰ لَكَ فَأَوْلَىٰ",
   "simple": "أولى لك فأولى"
  },
  {
   "ayah": 35,
   "uthmani": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ",
   "simple": "ثم أولى لك فأولى"
  },
  {
   "ayah": 36,
   "uthmani": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى",
   "simple": "أيحسب الإنسان أن يترك سدى"
  },
  {
   "ayah": 37,
   "uthmani": "أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ",
   "simple": "ألم يك نطفة من مني يمنى"
  },
  {
   "ayah": 38,
   "uthmani": "ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ",
   "simple": "ثم كان علقة فخلق فسوى"
  },
  {
   "ayah": 39,
   "uthmani": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
   "simple": "فجعل منه الزوجين الذكر والأنثى"
  },
  {
   "ayah": 40,
   "uthmani": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ",
   "simple": "أليس ذلك بقادر على أن يحيي الموتى"
  }
 ]
}