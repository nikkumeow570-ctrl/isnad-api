{
 "surah": 37,
 "name_arabic": "الصافات",
 "name_transliteration": "As-Saaffaat",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلصَّٰٓفَّٰتِ صَفًّا",
   "simple": "بسم الله الرحمن الرحيم والصافات صفا"
  },
  {
   "ayah": 2,
   "uthmani": "فَٱلزَّٰجِرَٰتِ زَجْرًا",
   "simple": "فالزاجرات زجرا"
  },
  {
   "ayah": 3,
   "uthmani": "فَٱلتَّٰلِيَٰتِ ذِكْرًا",
   "simple": "فالتاليات ذكرا"
  },
  {
   "ayah": 4,
   "uthmani": "إِنَّ إِلَٰهَكُمْ لَوَٰحِدٌ",
   "simple": "إن إلهكم لواحد"
  },
  {
   "ayah": 5,
   "uthmani": "رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَٰرِقِ",
   "simple": "رب السماوات والأرض وما بينهما ورب المشارق"
  },
  {
   "ayah": 6,
   "uthmani": "إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ",
   "simple": "إنا زينا السماء الدنيا بزينة الكواكب"
  },
  {
   "ayah": 7,
   "uthmani": "وَحِفْظًا مِّن كُلِّ شَيْطَٰنٍ مَّارِدٍ",
   "simple": "وحفظا من كل شيطان مارد"
  },
  {
   "ayah": 8,
   "uthmani": "لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ",
   "simple": "لا يسمعون إلى الملإ الأعلى ويقذفون من كل جانب"
  },
  {
   "ayah": 9,
   "uthmani": "دُحُورًا وَلَهُمْ عَذَابٌ وَاصِبٌ",
   "simple": "دحورا ولهم عذاب واصب"
  },
  {
   "ayah": 10,
   "uthmani": "إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌ ثَاقِبٌ",
   "simple": "إلا من خطف الخطفة فأتبعه شهاب ثاقب"
  },
  {
   "ayah": 11,
   "uthmani": "فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ إِنَّا خَلَقْنَٰهُم مِّن طِينٍ لَّازِبٍۭ",
   "simple": "فاستفتهم أهم أشد خلقا أم من خلقنا إنا خلقناهم من طين لازب"
  },
  {
   "ayah": 12,
   "uthmani": "بَلْ عَجِبْتَ وَيَسْخَرُونَ",
   "simple": "بل عجبت ويسخرون"
  },
  {
   "ayah": 13,
   "uthmani": "وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ",
   "simple": "وإذا ذكروا لا يذكرون"
  },
  {
   "ayah": 14,
   "uthmani": "وَإِذَا رَأَوْا۟ ءَايَةً يَسْتَسْخِرُونَ",
   "simple": "وإذا رأوا آية يستسخرون"
  },
  {
   "ayah": 15,
   "uthmani": "وَقَالُوٓا۟ إِنْ هَٰذَآ إِلَّا سِحْرٌ مُّبِينٌ",
   "simple": "وقالوا إن هذا إلا سحر مبين"
  },
  {
   "ayah": 16,
   "uthmani": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ",
   "simple": "أإذا متنا وكنا ترابا وعظاما أإنا لمبعوثون"
  },
  {
   "ayah": 17,
   "uthmani": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ",
   "simple": "أوآباؤنا الأولون"
  },
  {
   "ayah": 18,
   "uthmani": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ",
   "simple": "قل نعم وأنتم داخرون"
  },
  {
   "ayah": 19,
   "uthmani": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ",
   "simple": "فإنما هي زجرة واحدة فإذا هم ينظرون"
  },
  {
   "ayah": 20,
   "uthmani": "وَقَالُوا۟ يَٰوَيْلَنَا هَٰذَا يَوْمُ ٱلدِّينِ",
   "simple": "وقالوا يا ويلنا هذا يوم الدين"
  },
  {
   "ayah": 21,
   "uthmani": "هَٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ",
   "simple": "هذا يوم الفصل الذي كنتم به تكذبون"
  },
  {
   "ayah": 22,
   "uthmani": "ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ",
   "simple": "احشروا الذين ظلموا وأزواجهم وما كانوا يعبدون"
  },
  {
   "ayah": 23,
   "uthmani": "مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ",
   "simple": "من دون الله فاهدوهم إلى صراط الجحيم"
  },
  {
   "ayah": 24,
   "uthmani": "وَقِفُوهُمْ إِنَّهُم مَّسْـُٔولُونَ",
   "simple": "وقفوهم إنهم مسئولون"
  },
  {
   "ayah": 25,
   "uthmani": "مَا لَكُمْ لَا تَنَاصَرُونَ",
   "simple": "ما لكم لا تناصرون"
  },
  {
   "ayah": 26,
   "uthmani": "بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ",
   "simple": "بل هم اليوم مستسلمون"
  },
  {
   "ayah": 27,
   "uthmani": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ",
   "simple": "وأقبل بعضهم على بعض يتساءلون"
  },
  {
   "ayah": 28,
   "uthmani": "قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ",
   "simple": "قالوا إنكم كنتم تأتوننا عن اليمين"
  },
  {
   "ayah": 29,
   "uthmani": "قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ",
   "simple": "قالوا بل لم تكونوا مؤمنين"
  },
  {
   "ayah": 30,
   "uthmani": "وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنٍۭ بَلْ كُنتُمْ قَوْمًا طَٰغِينَ",
   "simple": "وما كان لنا عليكم من سلطان بل كنتم قوما طاغين"
  },
  {
   "ayah": 31,
   "uthmani": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ إِنَّا لَذَآئِقُونَ",
   "simple": "فحق علينا قول ربنا إنا لذائقون"
  },
  {
   "ayah": 32,
   "uthmani": "فَأَغْوَيْنَٰكُمْ إِنَّا كُنَّا غَٰوِينَ",
   "simple": "فأغويناكم إنا كنا غاوين"
  },
  {
   "ayah": 33,
   "uthmani": "فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ",
   "simple": "فإنهم يومئذ في العذاب مشتركون"
  },
  {
   "ayah": 34,
   "uthmani": "إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
   "simple": "إنا كذلك نفعل بالمجرمين"
  },
  {
   "ayah": 35,
   "uthmani": "إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ",
   "simple": "إنهم كانوا إذا قيل لهم لا إله إلا الله يستكبرون"
  },
  {
   "ayah": 36,
   "uthmani": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ",
   "simple": "ويقولون أئنا لتاركو آلهتنا لشاعر مجنون"
  },
  {
   "ayah": 37,
   "uthmani": "بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ",
   "simple": "بل جاء بالحق وصدق المرسلين"
  },
  {
   "ayah": 38,
   "uthmani": "إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ",
   "simple": "إنكم لذائقو العذاب الأليم"
  },
  {
   "ayah": 39,
   "uthmani": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ",
   "simple": "وما تجزون إلا ما كنتم تعملون"
  },
  {
   "ayah": 40,
   "uthmani": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ",
   "simple": "إلا عباد الله المخلصين"
  },
  {
   "ayah": 41,
   "uthmani": "أُو۟لَٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ",
   "simple": "أولئك لهم رزق معلوم"
  },
  {
   "ayah": 42,
   "uthmani": "فَوَٰكِهُ وَهُم مُّكْرَمُونَ",
   "simple": "فواكه وهم مكرمون"
  },
  {
   "ayah": 43,
   "uthmani": "فِى جَنَّٰتِ ٱلنَّعِيمِ",
   "simple": "في جنات النعيم"
  },
  {
   "ayah": 44,
   "uthmani": "عَلَىٰ سُرُرٍ مُّتَقَٰبِلِينَ",
   "simple": "على سرر متقابلين"
  },
  {
   "ayah": 45,
   "uthmani": "يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ",
   "simple": "يطاف عليهم بكأس من معين"
  },
  {
   "ayah": 46,
   "uthmani": "بَيْضَآءَ لَذَّةٍ لِّلشَّٰرِبِينَ",
   "simple": "بيضاء لذة للشاربين"
  },
  {
   "ayah": 47,
   "uthmani": "لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ",
   "simple": "لا فيها غول ولا هم عنها ينزفون"
  },
  {
   "ayah": 48,
   "uthmani": "وَعِندَهُمْ قَٰصِرَٰتُ ٱلطَّرْفِ عِينٌ",
   "simple": "وعندهم قاصرات الطرف عين"
  },
  {
   "ayah": 49,
   "uthmani": "كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ",
   "simple": "كأنهن بيض مكنون"
  },
  {
   "ayah": 50,
   "uthmani": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ",
   "simple": "فأقبل بعضهم على بعض يتساءلون"
  },
  {
   "ayah": 51,
   "uthmani": "قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ",
   "simple": "قال قائل منهم إني كان لي قرين"
  },
  {
   "ayah": 52,
   "uthmani": "يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ",
   "simple": "يقول أإنك لمن المصدقين"
  },
  {
   "ayah": 53,
   "uthmani": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ",
   "simple": "أإذا متنا وكنا ترابا وعظاما أإنا لمدينون"
  },
  {
   "ayah": 54,
   "uthmani": "قَالَ هَلْ أَنتُم مُّطَّلِعُونَ",
   "simple": "قال هل أنتم مطلعون"
  },
  {
   "ayah": 55,
   "uthmani": "فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ",
   "simple": "فاطلع فرآه في سواء الجحيم"
  },
  {
   "ayah": 56,
   "uthmani": "قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ",
   "simple": "قال تالله إن كدت لتردين"
  },
  {
   "ayah": 57,
   "uthmani": "وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ",
   "simple": "ولولا نعمة ربي لكنت من المحضرين"
  },
  {
   "ayah": 58,
   "uthmani": "أَفَمَا نَحْنُ بِمَيِّتِينَ",
   "simple": "أفما نحن بميتين"
  },
  {
   "ayah": 59,
   "uthmani": "إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ",
   "simple": "إلا موتتنا الأولى وما نحن بمعذبين"
  },
  {
   "ayah": 60,
   "uthmani": "إِنَّ هَٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ",
   "simple": "إن هذا لهو الفوز العظيم"
  },
  {
   "ayah": 61,
   "uthmani": "لِمِثْلِ هَٰذَا فَلْيَعْمَلِ ٱلْعَٰمِلُونَ",
   "simple": "لمثل هذا فليعمل العاملون"
  },
  {
   "ayah": 62,
   "uthmani": "أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ",
   "simple": "أذلك خير نزلا أم شجرة الزقوم"
  },
  {
   "ayah": 63,
   "uthmani": "إِنَّا جَعَلْنَٰهَا فِتْنَةً لِّلظَّٰلِمِينَ",
   "simple": "إنا جعلناها فتنة للظالمين"
  },
  {
   "ayah": 64,
   "uthmani": "إِنَّهَا شَجَرَةٌ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ",
   "simple": "إنها شجرة تخرج في أصل الجحيم"
  },
  {
   "ayah": 65,
   "uthmani": "طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ",
   "simple": "طلعها كأنه رءوس الشياطين"
  },
  {
   "ayah": 66,
   "uthmani": "فَإِنَّهُمْ لَـَٔاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ",
   "simple": "فإنهم لآكلون منها فمالئون منها البطون"
  },
  {
   "ayah": 67,
   "uthmani": "ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ",
   "simple": "ثم إن لهم عليها لشوبا من حميم"
  },
  {
   "ayah": 68,
   "uthmani": "ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ",
   "simple": "ثم إن مرجعهم لإلى الجحيم"
  },
  {
   "ayah": 69,
   "uthmani": "إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ ضَآلِّينَ",
   "simple": "إنهم ألفوا آباءهم ضالين"
  },
  {
   "ayah": 70,
   "uthmani": "فَهُمْ عَلَىٰٓ ءَاثَٰرِهِمْ يُهْرَعُونَ",
   "simple": "فهم على آثارهم يهرعون"
  },
  {
   "ayah": 71,
   "uthmani": "وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ",
   "simple": "ولقد ضل قبلهم أكثر الأولين"
  },
  {
   "ayah": 72,
   "uthmani": "وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ",
   "simple": "ولقد أرسلنا فيهم منذرين"
  },
  {
   "ayah": 73,
   "uthmani": "فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُنذَرِينَ",
   "simple": "فانظر كيف كان عاقبة المنذرين"
  },
  {
   "ayah": 74,
   "uthmani": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ",
   "simple": "إلا عباد الله المخلصين"
  },
  {
   "ayah": 75,
   "uthmani": "وَلَقَدْ نَادَىٰنَا نُوحٌ فَلَنِعْمَ ٱلْمُجِيبُونَ",
   "simple": "ولقد نادانا نوح فلنعم المجيبون"
  },
  {
   "ayah": 76,
   "uthmani": "وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ",
   "simple": "ونجيناه وأهله من الكرب العظيم"
  },
  {
   "ayah": 77,
   "uthmani": "وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ ٱلْبَاقِينَ",
   "simple": "وجعلنا ذريته هم الباقين"
  },
  {
   "ayah": 78,
   "uthmani": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ",
   "simple": "وتركنا عليه في الآخرين"
  },
  {
   "ayah": 79,
   "uthmani": "سَلَٰمٌ عَلَىٰ نُوحٍ فِى ٱلْعَٰلَمِينَ",
   "simple": "سلام على نوح في العالمين"
  },
  {
   "ayah": 80,
   "uthmani": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
   "simple": "إنا كذلك نجزي المحسنين"
  },
  {
   "ayah": 81,
   "uthmani": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ",
   "simple": "إنه من عبادنا المؤمنين"
  },
  {
   "ayah": 82,
   "uthmani": "ثُمَّ أَغْرَقْنَا ٱلْـَٔاخَرِينَ",
   "simple": "ثم أغرقنا الآخرين"
  },
  {
   "ayah": 83,
   "uthmani": "وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ",
   "simple": "وإن من شيعته لإبراهيم"
  },
  {
   "ayah": 84,
   "uthmani": "إِذْ جَآءَ رَبَّهُۥ بِقَلْبٍ سَلِيمٍ",
   "simple": "إذ جاء ربه بقلب سليم"
  },
  {
   "ayah": 85,
   "uthmani": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَ",
   "simple": "إذ قال لأبيه وقومه ماذا تعبدون"
  },
  {
   "ayah": 86,
   "uthmani": "أَئِفْكًا ءَالِهَةً دُونَ ٱللَّهِ تُرِيدُونَ",
   "simple": "أئفكا آلهة دون الله تريدون"
  },
  {
   "ayah": 87,
   "uthmani": "فَمَا ظَنُّكُم بِرَبِّ ٱلْعَٰلَمِينَ",
   "simple": "فما ظنكم برب العالمين"
  },
  {
   "ayah": 88,
   "uthmani": "فَنَظَرَ نَظْرَةً فِى ٱلنُّجُومِ",
   "simple": "فنظر نظرة في النجوم"
  },
  {
   "ayah": 89,
   "uthmani": "فَقَالَ إِنِّى سَقِيمٌ",
   "simple": "فقال إني سقيم"
  },
  {
   "ayah": 90,
   "uthmani": "فَتَوَلَّوْا۟ عَنْهُ مُدْبِرِينَ",
   "simple": "فتولوا عنه مدبرين"
  },
  {
   "ayah": 91,
   "uthmani": "فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ",
   "simple": "فراغ إلى آلهتهم فقال ألا تأكلون"
  },
  {
   "ayah": 92,
   "uthmani": "مَا لَكُمْ لَا تَنطِقُونَ",
   "simple": "ما لكم لا تنطقون"
  },
  {
   "ayah": 93,
   "uthmani": "فَرَاغَ عَلَيْهِمْ ضَرْبًۢا بِٱلْيَمِينِ",
   "simple": "فراغ عليهم ضربا باليمين"
  },
  {
   "ayah": 94,
   "uthmani": "فَأَقْبَلُوٓا۟ إِلَيْهِ يَزِفُّونَ",
   "simple": "فأقبلوا إليه يزفون"
  },
  {
   "ayah": 95,
   "uthmani": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ",
   "simple": "قال أتعبدون ما تنحتون"
  },
  {
   "ayah": 96,
   "uthmani": "وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ",
   "simple": "والله خلقكم وما تعملون"
  },
  {
   "ayah": 97,
   "uthmani": "قَالُوا۟ ٱبْنُوا۟ لَهُۥ بُنْيَٰنًا فَأَلْقُوهُ فِى ٱلْجَحِيمِ",
   "simple": "قالوا ابنوا له بنيانا فألقوه في الجحيم"
  },
  {
   "ayah": 98,
   "uthmani": "فَأَرَادُوا۟ بِهِۦ كَيْدًا فَجَعَلْنَٰهُمُ ٱلْأَسْفَلِينَ",
   "simple": "فأرادوا به كيدا فجعلناهم الأسفلين"
  },
  {
   "ayah": 99,
   "uthmani": "وَقَالَ إِنِّى ذَاهِبٌ إِلَىٰ رَبِّى سَيَهْدِينِ",
   "simple": "وقال إني ذاهب إلى ربي سيهدين"
  },
  {
   "ayah": 100,
   "uthmani": "رَبِّ هَبْ لِى مِنَ ٱلصَّٰلِحِينَ",
   "simple": "رب هب لي من الصالحين"
  },
  {
   "ayah": 101,
   "uthmani": "فَبَشَّرْنَٰهُ بِغُلَٰمٍ حَلِيمٍ",
   "simple": "فبشرناه بغلام حليم"
  },
  {
   "ayah": 102,
   "uthmani": "فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعْىَ قَالَ يَٰبُنَىَّ إِنِّىٓ أَرَىٰ فِى ٱلْمَنَامِ أَنِّىٓ أَذْبَحُكَ فَٱنظُرْ مَاذَا تَرَىٰ قَالَ يَٰٓأَبَتِ ٱفْعَلْ مَا تُؤْمَرُ سَتَجِدُنِىٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰبِرِينَ",
   "simple": "فلما بلغ معه السعي قال يا بني إني أرى في المنام أني أذبحك فانظر ماذا ترى قال يا أبت افعل ما تؤمر ستجدني إن شاء الله من الصابرين"
  },
  {
   "ayah": 103,
   "uthmani": "فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ",
   "simple": "فلما أسلما وتله للجبين"
  },
  {
   "ayah": 104,
   "uthmani": "وَنَٰدَيْنَٰهُ أَن يَٰٓإِبْرَٰهِيمُ",
   "simple": "وناديناه أن يا إبراهيم"
  },
  {
   "ayah": 105,
   "uthmani": "قَدْ صَدَّقْتَ ٱلرُّءْيَآ إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
   "simple": "قد صدقت الرؤيا إنا كذلك نجزي المحسنين"
  },
  {
   "ayah": 106,
   "uthmani": "إِنَّ هَٰذَا لَهُوَ ٱلْبَلَٰٓؤُا۟ ٱلْمُبِينُ",
   "simple": "إن هذا لهو البلاء المبين"
  },
  {
   "ayah": 107,
   "uthmani": "وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمٍ",
   "simple": "وفديناه بذبح عظيم"
  },
  {
   "ayah": 108,
   "uthmani": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ",
   "simple": "وتركنا عليه في الآخرين"
  },
  {
   "ayah": 109,
   "uthmani": "سَلَٰمٌ عَلَىٰٓ إِبْرَٰهِيمَ",
   "simple": "سلام على إبراهيم"
  },
  {
   "ayah": 110,
   "uthmani": "كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
   "simple": "كذلك نجزي المحسنين"
  },
  {
   "ayah": 111,
   "uthmani": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ",
   "simple": "إنه من عبادنا المؤمنين"
  },
  {
   "ayah": 112,
   "uthmani": "وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيًّا مِّنَ ٱلصَّٰلِحِينَ",
   "simple": "وبشرناه بإسحاق نبيا من الصالحين"
  },
  {
   "ayah": 113,
   "uthmani": "وَبَٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَٰقَ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌ وَظَالِمٌ لِّنَفْسِهِۦ مُبِينٌ",
   "simple": "وباركنا عليه وعلى إسحاق ومن ذريتهما محسن وظالم لنفسه مبين"
  },
  {
   "ayah": 114,
   "uthmani": "وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ",
   "simple": "ولقد مننا على موسى وهارون"
  },
  {
   "ayah": 115,
   "uthmani": "وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ",
   "simple": "ونجيناهما وقومهما من الكرب العظيم"
  },
  {
   "ayah": 116,
   "uthmani": "وَنَصَرْنَٰهُمْ فَكَانُوا۟ هُمُ ٱلْغَٰلِبِينَ",
   "simple": "ونصرناهم فكانوا هم الغالبين"
  },
  {
   "ayah": 117,
   "uthmani": "وَءَاتَيْنَٰهُمَا ٱلْكِتَٰبَ ٱلْمُسْتَبِينَ",
   "simple": "وآتيناهما الكتاب المستبين"
  },
  {
   "ayah": 118,
   "uthmani": "وَهَدَيْنَٰهُمَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ",
   "simple": "وهديناهما الصراط المستقيم"
  },
  {
   "ayah": 119,
   "uthmani": "وَتَرَكْنَا عَلَيْهِمَا فِى ٱلْـَٔاخِرِينَ",
   "simple": "وتركنا عليهما في الآخرين"
  },
  {
   "ayah": 120,
   "uthmani": "سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ",
   "simple": "سلام على موسى وهارون"
  },
  {
   "ayah": 121,
   "uthmani": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
   "simple": "إنا كذلك نجزي المحسنين"
  },
  {
   "ayah": 122,
   "uthmani": "إِنَّهُمَا مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ",
   "simple": "إنهما من عبادنا المؤمنين"
  },
  {
   "ayah": 123,
   "uthmani": "وَإِنَّ إِلْيَاسَ لَمِنَ ٱلْمُرْسَلِينَ",
   "simple": "وإن إلياس لمن المرسلين"
  },
  {
   "ayah": 124,
   "uthmani": "إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ",
   "simple": "إذ قال لقومه ألا تتقون"
  },
  {
   "ayah": 125,
   "uthmani": "أَتَدْعُونَ بَعْلًا وَتَذَرُونَ أَحْسَنَ ٱلْخَٰلِقِينَ",
   "simple": "أتدعون بعلا وتذرون أحسن الخالقين"
  },
  {
   "ayah": 126,
   "uthmani": "ٱللَّهَ رَبَّكُمْ وَرَبَّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ",
   "simple": "الله ربكم ورب آبائكم الأولين"
  },
  {
   "ayah": 127,
   "uthmani": "فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ",
   "simple": "فكذبوه فإنهم لمحضرون"
  },
  {
   "ayah": 128,
   "uthmani": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ",
   "simple": "إلا عباد الله المخلصين"
  },
  {
   "ayah": 129,
   "uthmani": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ",
   "simple": "وتركنا عليه في الآخرين"
  },
  {
   "ayah": 130,
   "uthmani": "سَلَٰمٌ عَلَىٰٓ إِلْ يَاسِينَ",
   "simple": "سلام على إل ياسين"
  },
  {
   "ayah": 131,
   "uthmani": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
   "simple": "إنا كذلك نجزي المحسنين"
  },
  {
   "ayah": 132,
   "uthmani": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ",
   "simple": "إنه من عبادنا المؤمنين"
  },
  {
   "ayah": 133,
   "uthmani": "وَإِنَّ لُوطًا لَّمِنَ ٱلْمُرْسَلِينَ",
   "simple": "وإن لوطا لمن المرسلين"
  },
  {
   "ayah": 134,
   "uthmani": "إِذْ نَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ",
   "simple": "إذ نجيناه وأهله أجمعين"
  },
  {
   "ayah": 135,
   "uthmani": "إِلَّا عَجُوزًا فِى ٱلْغَٰبِرِينَ",
   "simple": "إلا عجوزا في الغابرين"
  },
  {
   "ayah": 136,
   "uthmani": "ثُمَّ دَمَّرْنَا ٱلْـَٔاخَرِينَ",
   "simple": "ثم دمرنا الآخرين"
  },
  {
   "ayah": 137,
   "uthmani": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ",
   "simple": "وإنكم لتمرون عليهم مصبحين"
  },
  {
   "ayah": 138,
   "uthmani": "وَبِٱلَّيْلِ أَفَلَا تَعْقِلُونَ",
   "simple": "وبالليل أفلا تعقلون"
  },
  {
   "ayah": 139,
   "uthmani": "وَإِنَّ يُونُسَ لَمِنَ ٱلْمُرْسَلِينَ",
   "simple": "وإن يونس لمن المرسلين"
  },
  {
   "ayah": 140,
   "uthmani": "إِذْ أَبَقَ إِلَى ٱلْفُلْكِ ٱلْمَشْحُونِ",
   "simple": "إذ أبق إلى الفلك المشحون"
  },
  {
   "ayah": 141,
   "uthmani": "فَسَاهَمَ فَكَانَ مِنَ ٱلْمُدْحَضِينَ",
   "simple": "فساهم فكان من المدحضين"
  },
  {
   "ayah": 142,
   "uthmani": "فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ مُلِيمٌ",
   "simple": "فالتقمه الحوت وهو مليم"
  },
  {
   "ayah": 143,
   "uthmani": "فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ ٱلْمُسَبِّحِينَ",
   "simple": "فلولا أنه كان من المسبحين"
  },
  {
   "ayah": 144,
   "uthmani": "لَلَبِثَ فِى بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَ",
   "simple": "للبث في بطنه إلى يوم يبعثون"
  },
  {
   "ayah": 145,
   "uthmani": "فَنَبَذْنَٰهُ بِٱلْعَرَآءِ وَهُوَ سَقِيمٌ",
   "simple": "فنبذناه بالعراء وهو سقيم"
  },
  {
   "ayah": 146,
   "uthmani": "وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةً مِّن يَقْطِينٍ",
   "simple": "وأنبتنا عليه شجرة من يقطين"
  },
  {
   "ayah": 147,
   "uthmani": "وَأَرْسَلْنَٰهُ إِلَىٰ مِا۟ئَةِ أَلْفٍ أَوْ يَزِيدُونَ",
   "simple": "وأرسلناه إلى مائة ألف أو يزيدون"
  },
  {
   "ayah": 148,
   "uthmani": "فَـَٔامَنُوا۟ فَمَتَّعْنَٰهُمْ إِلَىٰ حِينٍ",
   "simple": "فآمنوا فمتعناهم إلى حين"
  },
  {
   "ayah": 149,
   "uthmani": "فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ",
   "simple": "فاستفتهم ألربك البنات ولهم البنون"
  },
  {
   "ayah": 150,
   "uthmani": "أَمْ خَلَقْنَا ٱلْمَلَٰٓئِكَةَ إِنَٰثًا وَهُمْ شَٰهِدُونَ",
   "simple": "أم خلقنا الملائكة إناثا وهم شاهدون"
  },
  {
   "ayah": 151,
   "uthmani": "أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ",
   "simple": "ألا إنهم من إفكهم ليقولون"
  },
  {
   "ayah": 152,
   "uthmani": "وَلَدَ ٱللَّهُ وَإِنَّهُمْ لَكَٰذِبُونَ",
   "simple": "ولد الله وإنهم لكاذبون"
  },
  {
   "ayah": 153,
   "uthmani": "أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ",
   "simple": "أصطفى البنات على البنين"
  },
  {
   "ayah": 154,
   "uthmani": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ",
   "simple": "ما لكم كيف تحكمون"
  },
  {
   "ayah": 155,
   "uthmani": "أَفَلَا تَذَكَّرُونَ",
   "simple": "أفلا تذكرون"
  },
  {
   "ayah": 156,
   "uthmani": "أَمْ لَكُمْ سُلْطَٰنٌ مُّبِينٌ",
   "simple": "أم لكم سلطان مبين"
  },
  {
   "ayah": 157,
   "uthmani": "فَأْتُوا۟ بِكِتَٰبِكُمْ إِن كُنتُمْ صَٰدِقِينَ",
   "simple": "فأتوا بكتابكم إن كنتم صادقين"
  },
  {
   "ayah": 158,
   "uthmani": "وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًا وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ",
   "simple": "وجعلوا بينه وبين الجنة نسبا ولقد علمت الجنة إنهم لمحضرون"
  },
  {
   "ayah": 159,
   "uthmani": "سُبْحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ",
   "simple": "سبحان الله عما يصفون"
  },
  {
   "ayah": 160,
   "uthmani": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ",
   "simple": "إلا عباد الله المخلصين"
  },
  {
   "ayah": 161,
   "uthmani": "فَإِنَّكُمْ وَمَا تَعْبُدُونَ",
   "simple": "فإنكم وما تعبدون"
  },
  {
   "ayah": 162,
   "uthmani": "مَآ أَنتُمْ عَلَيْهِ بِفَٰتِنِينَ",
   "simple": "ما أنتم عليه بفاتنين"
  },
  {
   "ayah": 163,
   "uthmani": "إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ",
   "simple": "إلا من هو صال الجحيم"
  },
  {
   "ayah": 164,
   "uthmani": "وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌ مَّعْلُومٌ",
   "simple": "وما منا إلا له مقام معلوم"
  },
  {
   "ayah": 165,
   "uthmani": "وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ",
   "simple": "وإنا لنحن الصافون"
  },
  {
   "ayah": 166,
   "uthmani": "وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ",
   "simple": "وإنا لنحن المسبحون"
  },
  {
   "ayah": 167,
   "uthmani": "وَإِن كَانُوا۟ لَيَقُولُونَ",
   "simple": "وإن كانوا ليقولون"
  },
  {
   "ayah": 168,
   "uthmani": "لَوْ أَنَّ عِندَنَا ذِكْرًا مِّنَ ٱلْأَوَّلِينَ",
   "simple": "لو أن عندنا ذكرا من الأولين"
  },
  {
   "ayah": 169,
   "uthmani": "لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ",
   "simple": "لكنا عباد الله المخلصين"
  },
  {
   "ayah": 170,
   "uthmani": "فَكَفَرُوا۟ بِهِۦ فَسَوْفَ يَعْلَمُونَ",
   "simple": "فكفروا به فسوف يعلمون"
  },
  {
   "ayah": 171,
   "uthmani": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ",
   "simple": "ولقد سبقت كلمتنا لعبادنا المرسلين"
  },
  {
   "ayah": 172,
   "uthmani": "إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ",
   "simple": "إنهم لهم المنصورون"
  },
  {
   "ayah": 173,
   "uthmani": "وَإِنَّ جُندَنَا لَهُمُ ٱلْغَٰلِبُونَ",
   "simple": "وإن جندنا لهم الغالبون"
  },
  {
   "ayah": 174,
   "uthmani": "فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ",
   "simple": "فتول عنهم حتى حين"
  },
  {
   "ayah": 175,
   "uthmani": "وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ",
   "simple": "وأبصرهم فسوف يبصرون"
  },
  {
   "ayah": 176,
   "uthmani": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ",
   "simple": "أفبعذابنا يستعجلون"
  },
  {
   "ayah": 177,
   "uthmani": "فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ",
   "simple": "فإذا نزل بساحتهم فساء صباح المنذرين"
  },
  {
   "ayah": 178,
   "uthmani": "وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ",
   "simple": "وتول عنهم حتى حين"
  },
  {
   "ayah": 179,
   "uthmani": "وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ",
   "simple": "وأبصر فسوف يبصرون"
  },
  {
   "ayah": 180,
   "uthmani": "سُبْحَٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ",
   "simple": "سبحان ربك رب العزة عما يصفون"
  },
  {
   "ayah": 181,
   "uthmani": "وَسَلَٰمٌ عَلَى ٱلْمُرْسَلِينَ",
   "simple": "وسلام على المرسلين"
  },
  {
   "ayah": 182,
   "uthmani": "وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ",
   "simple": "والحمد لله رب العالمين"
  }
 ]
}