{
 "surah": 79,
 "name_arabic": "النازعات",
 "name_transliteration": "An-Naazi'aat",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًا",
   "simple": "بسم الله الرحمن الرحيم والنازعات غرقا"
  },
  {
   "ayah": 2,
   "uthmani": "وَٱلنَّٰشِطَٰتِ نَشْطًا",
   "simple": "والناشطات نشطا"
  },
  {
   "ayah": 3,
   "uthmani": "وَٱلسَّٰبِحَٰتِ سَبْحًا",
   "simple": "والسابحات سبحا"
  },
  {
   "ayah": 4,
   "uthmani": "فَٱلسَّٰبِقَٰتِ سَبْقًا",
   "simple": "فالسابقات سبقا"
  },
  {
   "ayah": 5,
   "uthmani": "فَٱلْمُدَبِّرَٰتِ أَمْرًا",
   "simple": "فالمدبرات أمرا"
  },
  {
   "ayah": 6,
   "uthmani": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
   "simple": "يوم ترجف الراجفة"
  },
  {
   "ayah": 7,
   "uthmani": "تَتْبَعُهَا ٱلرَّادِفَةُ",
   "simple": "تتبعها الرادفة"
  },
  {
   "ayah": 8,
   "uthmani": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ",
   "simple": "قلوب يومئذ واجفة"
  },
  {
   "ayah": 9,
   "uthmani": "أَبْصَٰرُهَا خَٰشِعَةٌ",
   "simple": "أبصارها خاشعة"
  },
  {
   "ayah": 10,
   "uthmani": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
   "simple": "يقولون أإنا لمردودون في الحافرة"
  },
  {
   "ayah": 11,
   "uthmani": "أَءِذَا كُنَّا عِظَٰمًا نَّخِرَةً",
   "simple": "أإذا كنا عظاما نخرة"
  },
  {
   "ayah": 12,
   "uthmani": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
   "simple": "قالوا تلك إذا كرة خاسرة"
  },
  {
   "ayah": 13,
   "uthmani": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ",
   "simple": "فإنما هي زجرة واحدة"
  },
  {
   "ayah": 14,
   "uthmani": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
   "simple": "فإذا هم بالساهرة"
  },
  {
   "ayah": 15,
   "uthmani": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
   "simple": "هل أتاك حديث موسى"
  },
  {
   "ayah": 16,
   "uthmani": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
   "simple": "إذ ناداه ربه بالواد المقدس طوى"
  },
  {
   "ayah": 17,
   "uthmani": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
   "simple": "اذهب إلى فرعون إنه طغى"
  },
  {
   "ayah": 18,
   "uthmani": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
   "simple": "فقل هل لك إلى أن تزكى"
  },
  {
   "ayah": 19,
   "uthmani": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
   "simple": "وأهديك إلى ربك فتخشى"
  },
  {
   "ayah": 20,
   "uthmani": "فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ",
   "simple": "فأراه الآية الكبرى"
  },
  {
   "ayah": 21,
   "uthmani": "فَكَذَّبَ وَعَصَىٰ",
   "simple": "فكذب وعصى"
  },
  {
   "ayah": 22,
   "uthmani": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
   "simple": "ثم أدبر يسعى"
  },
  {
   "ayah": 23,
   "uthmani": "فَحَشَرَ فَنَادَىٰ",
   "simple": "فحشر فنادى"
  },
  {
   "ayah": 24,
   "uthmani": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
   "simple": "فقال أنا ربكم الأعلى"
  },
  {
   "ayah": 25,
   "uthmani": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ",
   "simple": "فأخذه الله نكال الآخرة والأولى"
  },
  {
   "ayah": 26,
   "uthmani": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ",
   "simple": "إن في ذلك لعبرة لمن يخشى"
  },
  {
   "ayah": 27,
   "uthmani": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ بَنَىٰهَا",
   "simple": "أأنتم أشد خلقا أم السماء بناها"
  },
  {
   "ayah": 28,
   "uthmani": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
   "simple": "رفع سمكها فسواها"
  },
  {
   "ayah": 29,
   "uthmani": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
   "simple": "وأغطش ليلها وأخرج ضحاها"
  },
  {
   "ayah": 30,
   "uthmani": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
   "simple": "والأرض بعد ذلك دحاها"
  },
  {
   "ayah": 31,
   "uthmani": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",
   "simple": "أخرج منها ماءها ومرعاها"
  },
  {
   "ayah": 32,
   "uthmani": "وَٱلْجِبَالَ أَرْسَىٰهَا",
   "simple": "والجبال أرساها"
  },
  {
   "ayah": 33,
   "uthmani": "مَتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ",
   "simple": "متاعا لكم ولأنعامكم"
  },
  {
   "ayah": 34,
   "uthmani": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ",
   "simple": "فإذا جاءت الطامة الكبرى"
  },
  {
   "ayah": 35,
   "uthmani": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ",
   "simple": "يوم يتذكر الإنسان ما سعى"
  },
  {
   "ayah": 36,
   "uthmani": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ",
   "simple": "وبرزت الجحيم لمن يرى"
  },
  {
   "ayah": 37,
   "uthmani": "فَأَمَّا مَن طَغَىٰ",
   "simple": "فأما من طغى"
  },
  {
   "ayah": 38,
   "uthmani": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
   "simple": "وآثر الحياة الدنيا"
  },
  {
   "ayah": 39,
   "uthmani": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ",
   "simple": "فإن الجحيم هي المأوى"
  },
  {
   "ayah": 40,
   "uthmani": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",
   "simple": "وأما من خاف مقام ربه ونهى النفس عن الهوى"
  },
  {
   "ayah": 41,
   "uthmani": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ",
   "simple": "فإن الجنة هي المأوى"
  },
  {
   "ayah": 42,
   "uthmani": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا",
   "simple": "يسألونك عن الساعة أيان مرساها"
  },
  {
   "ayah": 43,
   "uthmani": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ",
   "simple": "فيم أنت من ذكراها"
  },
  {
   "ayah": 44,
   "uthmani": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ",
   "simple": "إلى ربك منتهاها"
  },
  {
   "ayah": 45,
   "uthmani": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا",
   "simple": "إنما أنت منذر من يخشاها"
  },
  {
   "ayah": 46,
   "uthmani": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا",
   "simple": "كأنهم يوم يرونها لم يلبثوا إلا عشية أو ضحاها"
  }
 ]
}