{
 "surah": 82,
 "name_arabic": "الإنفطار",
 "name_transliteration": "Al-Infitaar",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ",
   "simple": "بسم الله الرحمن الرحيم إذا السماء انفطرت"
  },
  {
   "ayah": 2,
   "uthmani": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ",
   "simple": "وإذا الكواكب انتثرت"
  },
  {
   "ayah": 3,
   "uthmani": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ",
   "simple": "وإذا البحار فجرت"
  },
  {
   "ayah": 4,
   "uthmani": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ",
   "simple": "وإذا القبور بعثرت"
  },
  {
   "ayah": 5,
   "uthmani": "عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ",
   "simple": "علمت نفس ما قدمت وأخرت"
  },
  {
   "ayah": 6,
   "uthmani": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ",
   "simple": "يا أيها الإنسان ما غرك بربك الكريم"
  },
  {
   "ayah": 7,
   "uthmani": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
   "simple": "الذي خلقك فسواك فعدلك"
  },
  {
   "ayah": 8,
   "uthmani": "فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ",
   "simple": "في أي صورة ما شاء ركبك"
  },
  {
   "ayah": 9,
   "uthmani": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ",
   "simple": "كلا بل تكذبون بالدين"
  },
  {
   "ayah": 10,
   "uthmani": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ",
   "simple": "وإن عليكم لحافظين"
  },
  {
   "ayah": 11,
   "uthmani": "كِرَامًا كَٰتِبِينَ",
   "simple": "كراما كاتبين"
  },
  {
   "ayah": 12,
   "uthmani": "يَعْلَمُونَ مَا تَفْعَلُونَ",
   "simple": "يعلمون ما تفعلون"
  },
  {
   "ayah": 13,
   "uthmani": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ",
   "simple": "إن الأبرار لفي نعيم"
  },
  {
   "ayah": 14,
   "uthmani": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ",
   "simple": "وإن الفجار لفي جحيم"
  },
  {
   "ayah": 15,
   "uthmani": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ",
   "simple": "يصلونها يوم الدين"
  },
  {
   "ayah": 16,
   "uthmani": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ",
   "simple": "وما هم عنها بغائبين"
  },
  {
   "ayah": 17,
   "uthmani": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
   "simple": "وما أدراك ما يوم الدين"
  },
  {
   "ayah": 18,
   "uthmani": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
   "simple": "ثم ما أدراك ما يوم الدين"
  },
  {
   "ayah": 19,
   "uthmani": "يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ",
   "simple": "يوم لا تملك نفس لنفس شيئا والأمر يومئذ لله"
  }
 ]
}