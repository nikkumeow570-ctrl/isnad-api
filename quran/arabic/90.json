{
 "surah": 90,
 "name_arabic": "البلد",
 "name_transliteration": "Al-Balad",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ",
   "simple": "بسم الله الرحمن الرحيم لا أقسم بهذا البلد"
  },
  {
   "ayah": 2,
   "uthmani": "وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ",
   "simple": "وأنت حل بهذا البلد"
  },
  {
   "ayah": 3,
   "uthmani": "وَوَالِدٍ وَمَا وَلَدَ",
   "simple": "ووالد وما ولد"
  },
  {
   "ayah": 4,
   "uthmani": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ",
   "simple": "لقد خلقنا الإنسان في كبد"
  },
  {
   "ayah": 5,
   "uthmani": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ",
   "simple": "أيحسب أن لن يقدر عليه أحد"
  },
  {
   "ayah": 6,
   "uthmani": "يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا",
   "simple": "يقول أهلكت مالا لبدا"
  },
  {
   "ayah": 7,
   "uthmani": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ",
   "simple": "أيحسب أن لم يره أحد"
  },
  {
   "ayah": 8,
   "uthmani": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ",
   "simple": "ألم نجعل له عينين"
  },
  {
   "ayah": 9,
   "uthmani": "وَلِسَانًا وَشَفَتَيْنِ",
   "simple": "ولسانا وشفتين"
  },
  {
   "ayah": 10,
   "uthmani": "وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ",
   "simple": "وهديناه النجدين"
  },
  {
   "ayah": 11,
   "uthmani": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ",
   "simple": "فلا اقتحم العقبة"
  },
  {
   "ayah": 12,
   "uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ",
   "simple": "وما أدراك ما العقبة"
  },
  {
   "ayah": 13,
   "uthmani": "فَكُّ رَقَبَةٍ",
   "simple": "فك رقبة"
  },
  {
   "ayah": 14,
   "uthmani": "أَوْ إِطْعَٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ",
   "simple": "أو إطعام في يوم ذي مسغبة"
  },
  {
   "ayah": 15,
   "uthmani": "يَتِيمًا ذَا مَقْرَبَةٍ",
   "simple": "يتيما ذا مقربة"
  },
  {
   "ayah": 16,
   "uthmani": "أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ",
   "simple": "أو مسكينا ذا متربة"
  },
  {
   "ayah": 17,
   "uthmani": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ",
   "simple": "ثم كان من الذين آمنوا وتواصوا بالصبر وتواصوا بالمرحمة"
  },
  {
   "ayah": 18,
   "uthmani": "أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ",
   "simple": "أولئك أصحاب الميمنة"
  },
  {
   "ayah": 19,
   "uthmani": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ",
   "simple": "والذين كفروا بآياتنا هم أصحاب المشأمة"
  },
  {
   "ayah": 20,
   "uthmani": "عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ",
   "simple": "عليهم نار مؤصدة"
  }
 ]
}