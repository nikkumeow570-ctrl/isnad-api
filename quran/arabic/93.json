{
 "surah": 93,
 "name_arabic": "الضحى",
 "name_transliteration": "Ad-Dhuhaa",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ",
   "simple": "بسم الله الرحمن الرحيم والضحى"
  },
  {
   "ayah": 2,
   "uthmani": "وَٱلَّيْلِ إِذَا سَجَىٰ",
   "simple": "والليل إذا سجى"
  },
  {
   "ayah": 3,
   "uthmani": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
   "simple": "ما ودعك ربك وما قلى"
  },
  {
   "ayah": 4,
   "uthmani": "وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ",
   "simple": "وللآخرة خير لك من الأولى"
  },
  {
   "ayah": 5,
   "uthmani": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ",
   "simple": "ولسوف يعطيك ربك فترضى"
  },
  {
   "ayah": 6,
   "uthmani": "أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ",
   "simple": "ألم يجدك يتيما فآوى"
  },
  {
   "ayah": 7,
   "uthmani": "وَوَجَدَكَ ضَآلًّا فَهَدَىٰ",
   "simple": "ووجدك ضالا فهدى"
  },
  {
   "ayah": 8,
   "uthmani": "وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ",
   "simple": "ووجدك عائلا فأغنى"
  },
  {
   "ayah": 9,
   "uthmani": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ",
   "simple": "فأما اليتيم فلا تقهر"
  },
  {
   "ayah": 10,
   "uthmani": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ",
   "simple": "وأما السائل فلا تنهر"
  },
  {
   "ayah": 11,
   "uthmani": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ",
   "simple": "وأما بنعمة ربك فحدث"
  }
 ]
}