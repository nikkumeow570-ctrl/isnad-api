{
 "surah": 84,
 "name_arabic": "الإنشقاق",
 "name_transliteration": "Al-Inshiqaaq",
 "type": "meccan",
 "source": "Tanzil Quran Text (Uthmani, Simple Clean)",
 "license": "Tanzil Quran text, CC BY 3.0, verbatim copy. https://tanzil.net/docs/text_license",
 "verses": [
  {
   "ayah": 1,
   "uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ",
   "simple": "بسم الله الرحمن الرحيم إذا السماء انشقت"
  },
  {
   "ayah": 2,
   "uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
   "simple": "وأذنت لربها وحقت"
  },
  {
   "ayah": 3,
   "uthmani": "وَإِذَا ٱلْأَرْضُ مُدَّتْ",
   "simple": "وإذا الأرض مدت"
  },
  {
   "ayah": 4,
   "uthmani": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",
   "simple": "وألقت ما فيها وتخلت"
  },
  {
   "ayah": 5,
   "uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
   "simple": "وأذنت لربها وحقت"
  },
  {
   "ayah": 6,
   "uthmani": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَٰقِيهِ",
   "simple": "يا أيها الإنسان إنك كادح إلى ربك كدحا فملاقيه"
  },
  {
   "ayah": 7,
   "uthmani": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ",
   "simple": "فأما من أوتي كتابه بيمينه"
  },
  {
   "ayah": 8,
   "uthmani": "فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا",
   "simple": "فسوف يحاسب حسابا يسيرا"
  },
  {
   "ayah": 9,
   "uthmani": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا",
   "simple": "وينقلب إلى أهله مسرورا"
  },
  {
   "ayah": 10,
   "uthmani": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ",
   "simple": "وأما من أوتي كتابه وراء ظهره"
  },
  {
   "ayah": 11,
   "uthmani": "فَسَوْفَ يَدْعُوا۟ ثُبُورًا",
   "simple": "فسوف يدعو ثبورا"
  },
  {
   "ayah": 12,
   "uthmani": "وَيَصْلَىٰ سَعِيرًا",
   "simple": "ويصلى سعيرا"
  },
  {
   "ayah": 13,
   "uthmani": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا",
   "simple": "إنه كان في أهله مسرورا"
  },
  {
   "ayah": 14,
   "uthmani": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ",
   "simple": "إنه ظن أن لن يحور"
  },
  {
   "ayah": 15,
   "uthmani": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا",
   "simple": "بلى إن ربه كان به بصيرا"
  },
  {
   "ayah": 16,
   "uthmani": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ",
   "simple": "فلا أقسم بالشفق"
  },
  {
   "ayah": 17,
   "uthmani": "وَٱلَّيْلِ وَمَا وَسَقَ",
   "simple": "والليل وما وسق"
  },
  {
   "ayah": 18,
   "uthmani": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ",
   "simple": "والقمر إذا اتسق"
  },
  {
   "ayah": 19,
   "uthmani": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ",
   "simple": "لتركبن طبقا عن طبق"
  },
  {
   "ayah": 20,
   "uthmani": "فَمَا لَهُمْ لَا يُؤْمِنُونَ",
   "simple": "فما لهم لا يؤمنون"
  },
  {
   "ayah": 21,
   "uthmani": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ",
   "simple": "وإذا قرئ عليهم القرآن لا يسجدون"
  },
  {
   "ayah": 22,
   "uthmani": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ",
   "simple": "بل الذين كفروا يكذبون"
  },
  {
   "ayah": 23,
   "uthmani": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ",
   "simple": "والله أعلم بما يوعون"
  },
  {
   "ayah": 24,
   "uthmani": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ",
   "simple": "فبشرهم بعذاب أليم"
  },
  {
   "ayah": 25,
   "uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ",
   "simple": "إلا الذين آمنوا وعملوا الصالحات لهم أجر غير ممنون"
  }
 ]
}