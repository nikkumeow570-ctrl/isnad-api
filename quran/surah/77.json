{
  "surah": 77,
  "name": "அல்-முர்ஸலாத்",
  "source": "TNTJ",
  "verses": [
    {
      "ayah": 1,
      "ayah_end": 2,
      "tamil": "தொடர்ந்து அனுப்பப்படுபவை மீதும், கடுமையாக வீசும் புயல் மீதும் சத்தியமாக!"
    },
    {
      "ayah": 3,
      "ayah_end": 4,
      "tamil": "பரப்பி விடுபவை மீதும், ஒரேயடியாகப் பிரித்து விடுபவை மீதும் சத்தியமாக!"
    },
    {
      "ayah": 5,
      "ayah_end": 6,
      "tamil": "மன்னிப்பாகவோ, எச்சரிக்கையாகவோ படிப்பினையைப் போடுபவற்றின் (காற்றின்) மீது சத்தியமாக!"
    },
    {
      "ayah": 7,
      "tamil": "உங்களுக்கு எச்சரிக்கப்படுவது நடந்தேறும்."
    },
    {
      "ayah": 8,
      "tamil": "நட்சத்திரங்கள் ஒளியிழக்கும் போது,"
    },
    {
      "ayah": 9,
      "tamil": "வானம் பிளக்கப்படும் போது,"
    },
    {
      "ayah": 10,
      "tamil": "மலைகள் சிதறடிக்கப்படும் போது,"
    },
    {
      "ayah": 11,
      "tamil": "தூதர்களுக்கு நேரம் குறிக்கப்படும் போது (அது நடந்தேறும்)"
    },
    {
      "ayah": 12,
      "tamil": "(இவை) எந்த நாளுக்காகத் தாமதப்படுத்தப்பட்டுள்ளது?"
    },
    {
      "ayah": 13,
      "tamil": "தீர்ப்பு நாளுக்காகவே!"
    },
    {
      "ayah": 14,
      "tamil": "தீர்ப்பு நாள் என்னவென்று உமக்கு எப்படித் தெரியும்?"
    },
    {
      "ayah": 15,
      "tamil": "பொய்யெனக் கருதியோருக்கு அந்நாளில் கேடு தான்."
    },
    {
      "ayah": 16,
      "tamil": "முன்னோர்களை நாம் அழிக்கவில்லையா?"
    },
    {
      "ayah": 17,
      "tamil": "பின்னோரை அவர்களைத் தொடர்ந்து வரச் செய்யவில்லையா?"
    },
    {
      "ayah": 18,
      "tamil": "இவ்வாறே குற்றவாளிகளை நடத்துவோம்."
    },
    {
      "ayah": 19,
      "tamil": "பொய்யெனக் கருதியோருக்கு அந்நாளில் கேடு தான்."
    },
    {
      "ayah": 20,
      "tamil": "உங்களை அற்பமான நீரிலிருந்து நாம் படைக்கவில்லையா?"
    },
    {
      "ayah": 21,
      "ayah_end": 22,
      "tamil": "குறிப்பிட்ட காலம் வரை அதை பாதுகாப்பான இடத்தில் நாம் வைக்கவில்லையா?"
    },
    {
      "ayah": 23,
      "tamil": "நாமே நிர்ணயித்தோம். நிர்ணயம் செய்வோரில் நாமே சிறந்தவர்கள்."
    },
    {
      "ayah": 24,
      "tamil": "பொய்யெனக் கருதியோருக்கு அந்நாளில் கேடு தான்."
    },
    {
      "ayah": 25,
      "ayah_end": 26,
      "tamil": "உயிருடன் உள்ளோரையும், இறந்தோரையும் அணைத்துக் கொள்ளக் கூடியதாக பூமியை ஆக்கவில்லையா?"
    },
    {
      "ayah": 27,
      "tamil": "அதில் உயர்ந்த முளைகளை நிறுவினோம். இனிமையான நீரையும் உங்களுக்குப் புகட்டினோம்."
    },
    {
      "ayah": 28,
      "tamil": "பொய்யெனக் கருதியோருக்கு அந்நாளில் கேடு தான்."
    },
    {
      "ayah": 29,
      "ayah_end": 30,
      "tamil": "நீங்கள் எதைப் பொய்யெனக் கருதினீர்களோ அதை நோக்கி மூன்று கிளைகளைக் கொண்ட நிழலை நோக்கி நடங்கள்!"
    },
    {
      "ayah": 31,
      "tamil": "அது நிழல் தரக் கூடியது அல்ல. அது தீயிலிருந்து பாதுகாக்காது."
    },
    {
      "ayah": 32,
      "tamil": "அது மாளிகையைப் போன்ற நெருப்புப் பந்தங்களை வீசியெறியும்."
    },
    {
      "ayah": 33,
      "tamil": "அது நிறத்தில் மஞ்சள் நிற ஒட்டகங்கள் போல் இருக்கும்."
    },
    {
      "ayah": 34,
      "tamil": "பொய்யெனக் கருதியோருக்கு அந்நாளில் கேடு தான்."
    },
    {
      "ayah": 35,
      "tamil": "இது அவர்கள் பேச முடியாத நாள்!"
    },
    {
      "ayah": 36,
      "tamil": "சமாதானமும் கூற அவர்களுக்கு அனுமதியளிக்கப்படாது."
    },
    {
      "ayah": 37,
      "tamil": "பொய்யெனக் கருதியோருக்கு அந்நாளில் கேடு தான்."
    },
    {
      "ayah": 38,
      "tamil": "இதுவே நியாயத் தீர்ப்பு நாள்! உங்களையும், முன்னோரையும் ஒன்று திரட்டினோம்."
    },
    {
      "ayah": 39,
      "tamil": "உங்களிடம் ஏதேனும் சூழ்ச்சி இருந்தால் எனக்கு சூழ்ச்சி செய்யுங்கள்!"
    },
    {
      "ayah": 40,
      "tamil": "பொய்யெனக் கருதியோருக்கு அந்நாளில் கேடு தான்."
    },
    {
      "ayah": 41,
      "tamil": "(இறைவனை) அஞ்சியோர் நிழல்களிலும், நீரூற்றுகளிலும் இருப்பார்கள்."
    },
    {
      "ayah": 42,
      "tamil": "அவர்கள் விரும்புகிற கனிகளிலும் இருப்பார்கள்."
    },
    {
      "ayah": 43,
      "tamil": "“நீங்கள் செய்து கொண்டிருந்ததன் காரணமாக மகிழ்வுடன் உண்ணுங்கள்! பருகுங்கள்!” (எனக் கூறப்படும்.)"
    },
    {
      "ayah": 44,
      "tamil": "இவ்வாறே நன்மை செய்தோருக்கு நாம் கூலி வழங்குவோம்."
    },
    {
      "ayah": 45,
      "tamil": "பொய்யெனக் கருதியோருக்கு அந்நாளில் கேடு தான்."
    },
    {
      "ayah": 46,
      "tamil": "சிறிது காலம் உண்ணுங்கள்! அனுபவியுங்கள்! நீங்கள் குற்றவாளிகள்."
    },
    {
      "ayah": 47,
      "tamil": "பொய்யெனக் கருதியோருக்கு அந்நாளில் கேடு தான்."
    },
    {
      "ayah": 48,
      "tamil": "ருகூவு செய்யுங்கள்! என்று அவர்களுக்குக் கூறப்பட்டால் அவர்கள் ருகூவு செய்ய மாட்டார்கள்."
    },
    {
      "ayah": 49,
      "tamil": "பொய்யெனக் கருதியோருக்கு அந்நாளில் கேடு தான்."
    },
    {
      "ayah": 50,
      "tamil": "இதன் பிறகு எந்தச் செய்தியைத் தான் அவர்கள் நம்புவார்கள்?"
    }
  ]
}
