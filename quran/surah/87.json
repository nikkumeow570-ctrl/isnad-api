{
  "surah": 87,
  "name": "அல்-அஃலா",
  "source": "TNTJ",
  "verses": [
    {
      "ayah": 1,
      "tamil": "மிக உயர்ந்த உமது இறைவனின் பெயரைத் துதிப்பீராக!"
    },
    {
      "ayah": 2,
      "tamil": "அவனே படைத்தான். ஒழுங்குற அமைத்தான்."
    },
    {
      "ayah": 3,
      "tamil": "அவனே நிர்ணயித்தான். வழி காட்டினான்."
    },
    {
      "ayah": 4,
      "tamil": "அவனே மேய்ச்சலுக்குரியதை வெளிப்படுத்தினான்."
    },
    {
      "ayah": 5,
      "tamil": "பின்னர் அவற்றை உலர்ந்த கூளங்களாக்கினான்."
    },
    {
      "ayah": 6,
      "tamil": "(முஹம்மதே!) உமக்கு ஓதிக் காட்டுவோம். நீர் மறக்க மாட்டீர்."
    },
    {
      "ayah": 7,
      "tamil": "அல்லாஹ் நாடியதைத் தவிர. அவன் பகிரங்கமானதையும், மறைவானதையும் அறிகிறான்."
    },
    {
      "ayah": 8,
      "tamil": "(முஹம்மதே!) எளியதை உமக்கு மேலும் எளிதாக்குவோம்."
    },
    {
      "ayah": 9,
      "tamil": "அறிவுரை பயன் தருமானால் நீர் அறிவுரை கூறுவீராக!"
    },
    {
      "ayah": 10,
      "tamil": "(இறைவனை) அஞ்சுபவன் படிப்பினை பெறுவான்."
    },
    {
      "ayah": 11,
      "tamil": "துர்பாக்கியசாலி அதிலிருந்து விலகிக் கொள்வான்."
    },
    {
      "ayah": 12,
      "tamil": "அவனே பெரும் நெருப்பில் கருகுவான்."
    },
    {
      "ayah": 13,
      "tamil": "பின்னர் அதில் சாகவும் மாட்டான். வாழவும் மாட்டான்."
    },
    {
      "ayah": 14,
      "tamil": "தூய்மையாக வாழ்பவன் வெற்றி பெற்றான்."
    },
    {
      "ayah": 15,
      "tamil": "தனது இறைவனின் பெயரை நினைத்து தொழுதான்."
    },
    {
      "ayah": 16,
      "tamil": "ஆனால் நீங்கள் இவ்வுலக வாழ்க்கையையே தேர்வு செய்கிறீர்கள்."
    },
    {
      "ayah": 17,
      "tamil": "மறுமையே சிறந்ததும், நிலையானதுமாகும்."
    },
    {
      "ayah": 18,
      "ayah_end": 19,
      "tamil": "இது முந்தைய வேதங்களிலும், இப்ராஹீம், மூஸாவுடைய வேதங்களிலும் உள்ளது."
    }
  ]
}
