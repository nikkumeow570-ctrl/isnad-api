{
  "surah": 112,
  "name": "அல்-இக்லாஸ்",
  "source": "TNTJ",
  "verses": [
    {
      "ayah": 1,
      "tamil": "“அல்லாஹ் ஒருவன்” என (முஹம்மதே!) கூறுவீராக!"
    },
    {
      "ayah": 2,
      "tamil": "அல்லாஹ் தேவையற்றவன்."
    },
    {
      "ayah": 3,
      "tamil": "(யாரையும்) அவன் பெறவில்லை. (யாருக்கும்) பிறக்கவுமில்லை."
    },
    {
      "ayah": 4,
      "tamil": "அவனுக்கு நிகராக யாருமில்லை."
    }
  ]
}
