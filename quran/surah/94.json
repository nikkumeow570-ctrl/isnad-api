{
  "surah": 94,
  "name": "அஷ்-ஷர்ஹ்",
  "source": "TNTJ",
  "verses": [
    {
      "ayah": 1,
      "tamil": "உமது உள்ளத்தை நாம் விரிவாக்க வில்லையா?"
    },
    {
      "ayah": 2,
      "ayah_end": 3,
      "tamil": "(முஹம்மதே!) உமது முதுகை முறித்துக் கொண்டிருந்த உமது சுமையை உம்மை விட்டும் நாம் இறக்கவில்லையா?"
    },
    {
      "ayah": 4,
      "tamil": "உமது புகழை உயர்த்தினோம்."
    },
    {
      "ayah": 5,
      "tamil": "சிரமத்துடன் தான் எளியதும் உள்ளது."
    },
    {
      "ayah": 6,
      "tamil": "சிரமத்துடன் தான் எளியதும் உள்ளது."
    },
    {
      "ayah": 7,
      "tamil": "எனவே ஓய்வெடுத்ததும் தயாராவீராக!"
    },
    {
      "ayah": 8,
      "tamil": "உமது இறைவனிடம் ஆசை வைப்பீராக!"
    }
  ]
}
