{
  "surah": 95,
  "name": "அத்-தீன்",
  "source": "TNTJ",
  "verses": [
    {
      "ayah": 1,
      "tamil": "அத்தியின் மீதும் ஒலிவ மரத்தின் மீதும் சத்தியமாக!"
    },
    {
      "ayah": 2,
      "tamil": "தூர் ஸீனீன் மலையின் மீதும் சத்தியமாக!"
    },
    {
      "ayah": 3,
      "tamil": "அபயமளிக்கும் இவ்வூர் மீதும் சத்தியமாக!"
    },
    {
      "ayah": 4,
      "tamil": "மனிதனை அழகிய வடிவில் படைத்தோம்."
    },
    {
      "ayah": 5,
      "tamil": "பின்னர் அவனை இழிந்தவனிலும் இழிந்தவனாக்கினோம்."
    },
    {
      "ayah": 6,
      "tamil": "நம்பிக்கை கொண்டு நல்லறம் செய்தோரைத் தவிர. அவர்களுக்கு முடிவு இல்லாத கூலி உண்டு."
    },
    {
      "ayah": 7,
      "tamil": "இதன் பின்னர் தீர்ப்பு நாளை உம்மால் எப்படிப் பொய்யெனக் கருத முடியும்?"
    },
    {
      "ayah": 8,
      "tamil": "தீர்ப்பளிப்போரில் அல்லாஹ் மேலான தீர்ப்பளிப்பவன் இல்லையா?"
    }
  ]
}
