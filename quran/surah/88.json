{
  "surah": 88,
  "name": "அல்-காஷியா",
  "source": "TNTJ",
  "verses": [
    {
      "ayah": 1,
      "tamil": "சுற்றி வளைக்கும் நிகழ்ச்சி பற்றி உமக்குச் செய்தி கிடைத்ததா?"
    },
    {
      "ayah": 2,
      "tamil": "அந்நாளில் சில முகங்கள் பணிவுடன் இருக்கும்."
    },
    {
      "ayah": 3,
      "tamil": "அவை (தீயவற்றில்) உறுதியாகச் செயல்பட்டன."
    },
    {
      "ayah": 4,
      "tamil": "சுட்டெரிக்கும் நெருப்பில் அவை கருகும்."
    },
    {
      "ayah": 5,
      "tamil": "கொதிக்கும் ஊற்றிலிருந்து புகட்டப்படும்."
    },
    {
      "ayah": 6,
      "tamil": "முட்செடி தவிர அவர்களுக்கு எந்த உணவும் இல்லை."
    },
    {
      "ayah": 7,
      "tamil": "அது கொழுக்க வைக்காது; பசியையும் நீக்காது."
    },
    {
      "ayah": 8,
      "tamil": "அந்நாளில் சில முகங்கள் மலர்ச்சியுடையதாக இருக்கும்."
    },
    {
      "ayah": 9,
      "tamil": "தமது உழைப்பிற்காகத் திருப்தி கொள்ளும்."
    },
    {
      "ayah": 10,
      "tamil": "உயர்ந்த சொர்க்கத்தில் இருக்கும்."
    },
    {
      "ayah": 11,
      "tamil": "அங்கே அவை வீணானதைச் செவியுறாது."
    },
    {
      "ayah": 12,
      "tamil": "அங்கே ஓடும் ஊற்றுகள் உண்டு."
    },
    {
      "ayah": 13,
      "tamil": "அங்கே உயர்ந்த கட்டில்கள் உள்ளன."
    },
    {
      "ayah": 14,
      "tamil": "குவளைகள் வைக்கப்பட்டிருக்கும்."
    },
    {
      "ayah": 15,
      "tamil": "வரிசைப்படுத்தப்பட்ட தலையணைகளும் உள்ளன."
    },
    {
      "ayah": 16,
      "tamil": "விரிக்கப்பட்ட கம்பளங்களும் உண்டு."
    },
    {
      "ayah": 17,
      "tamil": "ஒட்டகம் எவ்வாறு படைக்கப்பட்டுள்ளது என்பதை அவர்கள் பார்க்க வேண்டாமா?"
    },
    {
      "ayah": 18,
      "tamil": "வானம் எவ்வாறு உயர்த்தப்பட்டுள்ளது?"
    },
    {
      "ayah": 19,
      "tamil": "மலைகள் எவ்வாறு நாட்டி வைக்கப்பட்டுள்ளன?"
    },
    {
      "ayah": 20,
      "tamil": "பூமி எவ்வாறு விரிக்கப்பட்டுள்ளது? (என்பதையும் பார்க்க வேண்டாமா?)"
    },
    {
      "ayah": 21,
      "tamil": "எனவே அறிவுரை கூறுவீராக! (முஹம்மதே!) நீர் அறிவுரை கூறுபவரே."
    },
    {
      "ayah": 22,
      "tamil": "அவர்களுக்கு நீர் பொறுப்பாளி அல்லர்."
    },
    {
      "ayah": 23,
      "tamil": "புறக்கணித்து (ஏக இறைவனை) மறுப்பவன் தவிர."
    },
    {
      "ayah": 24,
      "tamil": "அவனை மிகக் கடுமையாக அல்லாஹ் தண்டிப்பான்."
    },
    {
      "ayah": 25,
      "tamil": "அவர்களுடைய மீளுதல் நம்மிடமே உள்ளது."
    },
    {
      "ayah": 26,
      "tamil": "பின்னர் அவர்களை விசாரிப்பது நம்மைச் சேர்ந்தது."
    }
  ]
}
