{
  "surah": 86,
  "name": "அத்-தாரிக்",
  "source": "TNTJ",
  "verses": [
    {
      "ayah": 1,
      "tamil": "வானத்தின் மீதும் தாரிக் மீதும் சத்தியமாக!"
    },
    {
      "ayah": 2,
      "tamil": "தாரிக் என்பது என்னவென உமக்கு எப்படித் தெரியும்?"
    },
    {
      "ayah": 3,
      "tamil": "அது ஒளி வீசும் நட்சத்திரம்."
    },
    {
      "ayah": 4,
      "tamil": "ஒவ்வொருவர் மீதும் காண்காணிப்பாளர் இல்லாமல் இல்லை."
    },
    {
      "ayah": 5,
      "tamil": "மனிதன் எதிலிருந்து படைக்கப்பட்டான் என்பதைச் சிந்திக்கட்டும்."
    },
    {
      "ayah": 6,
      "tamil": "குதித்து வெளிப்படும் நீரிலிருந்து படைக்கப்பட்டான்."
    },
    {
      "ayah": 7,
      "tamil": "அது முதுகுத் தண்டுக்கும் முன் பகுதிக்கும் இடையிலிருந்து வெளிப் படுகிறது."
    },
    {
      "ayah": 8,
      "tamil": "இவனை மீட்பதற்கு அவன் ஆற்றலுடையவன்."
    },
    {
      "ayah": 9,
      "tamil": "அந்நாளில் இரகசியங்கள் வெளிப்படுத்தப்படும்."
    },
    {
      "ayah": 10,
      "tamil": "அவனுக்கு எந்த வலிமையும், எந்த உதவியாளரும் இருக்க மாட்டார்கள்."
    },
    {
      "ayah": 11,
      "tamil": "திருப்பித் தரும் வானத்தின் மீது சத்தியமாக!"
    },
    {
      "ayah": 12,
      "tamil": "பிளக்கும் பூமியின் மீது சத்தியமாக!"
    },
    {
      "ayah": 13,
      "tamil": "இது தெளிவான கூற்றாகும்."
    },
    {
      "ayah": 14,
      "tamil": "இது கேலிக்குரியதல்ல."
    },
    {
      "ayah": 15,
      "tamil": "அவர்கள் கடும் சூழ்ச்சி செய்கின்றனர்."
    },
    {
      "ayah": 16,
      "tamil": "நானும் கடும் சூழ்ச்சி செய்கிறேன்."
    },
    {
      "ayah": 17,
      "tamil": "எனவே (என்னை) மறுப்போருக்கு அவகாசம் அளிப்பீராக! சொற்ப அவகாசம் அளிப்பீராக!"
    }
  ]
}
