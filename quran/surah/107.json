{
  "surah": 107,
  "name": "அல்-மாஊன்",
  "source": "TNTJ",
  "verses": [
    {
      "ayah": 1,
      "tamil": "தீர்ப்பு நாளை பொய்யெனக் கருதியவனைப் பார்த்தீரா?"
    },
    {
      "ayah": 2,
      "tamil": "அவனே அனாதையை விரட்டுகிறான்."
    },
    {
      "ayah": 3,
      "tamil": "ஏழைக்கு உணவளிக்க அவன் தூண்டுவதில்லை."
    },
    {
      "ayah": 4,
      "ayah_end": 5,
      "tamil": "தமது தொழுகையில் கவனமற்று தொழுவோருக்குக் கேடு தான்."
    },
    {
      "ayah": 6,
      "tamil": "அவர்கள் பிறருக்குக் காட்டுவதற்காகத் தொழுகின்றனர்."
    },
    {
      "ayah": 7,
      "tamil": "அற்பமானதையும் (கொடுக்க) மறுக்கின்றனர்."
    }
  ]
}
