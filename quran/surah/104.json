{
  "surah": 104,
  "name": "அல்-ஹுமஸா",
  "source": "TNTJ",
  "verses": [
    {
      "ayah": 1,
      "tamil": "குறை கூறிப் புறம் பேசும் ஒவ்வொருவனுக்கும் கேடு தான்."
    },
    {
      "ayah": 2,
      "tamil": "அவன் செல்வத்தைத் திரட்டி அதைக் கணக்கிடுகிறான்."
    },
    {
      "ayah": 3,
      "tamil": "தனது செல்வம் தன்னை நிலைத்திருக்கச் செய்யும் என்று எண்ணுகிறான்."
    },
    {
      "ayah": 4,
      "tamil": "அவ்வாறில்லை! ஹுதமாவில் அவன் எறியப்படுவான்."
    },
    {
      "ayah": 5,
      "tamil": "ஹுதமா என்பது என்னவென உமக்கு எப்படித் தெரியும்?"
    },
    {
      "ayah": 6,
      "ayah_end": 7,
      "tamil": "மூட்டப்பட்ட அல்லாஹ்வின் நெருப்பு. அது உள்ளங்களைச் சென்றடையும்."
    },
    {
      "ayah": 8,
      "ayah_end": 9,
      "tamil": "நீண்ட கம்பங்களில் அது அவர்களைச் சூழ்ந்திருக்கும்."
    }
  ]
}
