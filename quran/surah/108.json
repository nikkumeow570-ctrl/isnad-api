{
  "surah": 108,
  "name": "அல்-கவ்ஸர்",
  "source": "TNTJ",
  "verses": [
    {
      "ayah": 1,
      "tamil": "(முஹம்மதே!) கவ்ஸரை உமக்கு வழங்கினோம்."
    },
    {
      "ayah": 2,
      "tamil": "எனவே உமது இறைவனைத் தொழுது அவனுக்காக அறுப்பீராக!"
    },
    {
      "ayah": 3,
      "tamil": "உமது எதிரி தான் சந்ததியற்றவன்."
    }
  ]
}
