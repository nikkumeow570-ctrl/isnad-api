{
  "surah": 1,
  "name": "அல்-ஃபாத்திஹா",
  "source": "TNTJ",
  "verses": [
    {
      "ayah": 1,
      "tamil": "அளவற்ற அருளாளனும், நிகரற்ற அன்புடையோனுமாகிய அல்லாஹ்வின் பெயரால்..."
    },
    {
      "ayah": 2,
      "tamil": "எல்லாப் புகழும் அல்லாஹ்வுக்கே. (அவன்) அகிலத்தைப் (படைத்துப்) பராமரிப்பவன்."
    },
    {
      "ayah": 3,
      "tamil": "அளவற்ற அருளாளன். நிகரற்ற அன்புடையோன்."
    },
    {
      "ayah": 4,
      "tamil": "தீர்ப்பு நாளின் அதிபதி."
    },
    {
      "ayah": 5,
      "tamil": "(எனவே) உன்னையே வணங்குகிறோம். உன்னிடமே உதவியும் தேடுகிறோம்."
    },
    {
      "ayah": 6,
      "tamil": "எங்களை நேர் வழியில் செலுத்துவாயாக!"
    },
    {
      "ayah": 7,
      "tamil": "அது நீ யாருக்கு அருள் புரிந்தாயோ அவர்கள் வழி. அவர்கள் (உன்னால்) கோபிக்கப் படாதவர்கள், மற்றும் பாதை மாறிச் செல்லாதவர்கள்."
    }
  ]
}
