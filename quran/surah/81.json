{
  "surah": 81,
  "name": "அத்-தக்வீர்",
  "source": "TNTJ",
  "verses": [
    {
      "ayah": 1,
      "tamil": "சூரியன் சுருட்டப்படும் போது,"
    },
    {
      "ayah": 2,
      "tamil": "நட்சத்திரங்கள் உதிரும் போது,"
    },
    {
      "ayah": 3,
      "tamil": "மலைகள் பெயர்க்கப்படும் போது,"
    },
    {
      "ayah": 4,
      "tamil": "கருவுற்ற ஒட்டகங்கள் கவனிப்பாரற்று விடப்படும் போது,"
    },
    {
      "ayah": 5,
      "tamil": "விலங்குகள் ஒன்று திரட்டப்படும் போது,"
    },
    {
      "ayah": 6,
      "tamil": "கடல்கள் தீ மூட்டப்படும் போது,"
    },
    {
      "ayah": 7,
      "tamil": "உயிர்கள் மீண்டும் (உடல்களுடன்) சேர்க்கப்படும் போது,"
    },
    {
      "ayah": 8,
      "ayah_end": 9,
      "tamil": "என்ன பாவத்துக்காக கொல்லப்பட்டாள் என்று உயிருடன் புதைக்கப்பட்டவள் விசாரிக்கப்படும் போது,"
    },
    {
      "ayah": 10,
      "tamil": "ஏடுகள் விரிக்கப்படும் போது,"
    },
    {
      "ayah": 11,
      "tamil": "வானம் அகற்றப்படும் போது,"
    },
    {
      "ayah": 12,
      "tamil": "நரகம் கொளுத்தப்படும் போது,"
    },
    {
      "ayah": 13,
      "tamil": "சொர்க்கம் அருகே கொண்டு வரப்படும் போது,"
    },
    {
      "ayah": 14,
      "tamil": "ஒருவன், தான் முற்படுத்தியதை அறிந்து கொள்வான்."
    },
    {
      "ayah": 15,
      "ayah_end": 16,
      "tamil": "மறைந்தும் மறையாமலிருக்கிற, (முழுதும்) மறையக் கூடிய நட்சத்திரங்கள் மீது சத்தியம் செய்கிறேன்."
    },
    {
      "ayah": 17,
      "tamil": "பின்னோக்கிச் செல்லும் இரவின் மீது சத்தியமாக!"
    },
    {
      "ayah": 18,
      "tamil": "தெளிவாகும் காலைப் பொழுதின் மீது சத்தியமாக!"
    },
    {
      "ayah": 19,
      "tamil": "இது மரியாதைக்குரிய தூதரின் (ஜிப்ரீலின்) சொல்லாகும்."
    },
    {
      "ayah": 20,
      "tamil": "(அவர்) வலிமை மிக்கவர்; அர்ஷுக்கு உரியவனிடத்தில் தகுதிபெற்றவர்."
    },
    {
      "ayah": 21,
      "tamil": "வானவர்களின் தலைவர்; அங்கே நம்பிக்கைக்குரியவர்."
    },
    {
      "ayah": 22,
      "tamil": "உங்கள் தோழர் பைத்தியக்காரர் அல்லர்."
    },
    {
      "ayah": 23,
      "tamil": "அவரை (ஜிப்ரீலை) தெளிவான அடிவானத்தில் பார்த்தார்."
    },
    {
      "ayah": 24,
      "tamil": "அவர் (முஹம்மது) மறைவானவற்றில் கஞ்சத்தனம் செய்பவரல்லர்."
    },
    {
      "ayah": 25,
      "tamil": "இது விரட்டப்பட்ட ஷைத்தானின் கூற்று அல்ல."
    },
    {
      "ayah": 26,
      "tamil": "எங்கே செல்கிறீர்கள்?"
    },
    {
      "ayah": 27,
      "ayah_end": 28,
      "tamil": "இது அகிலத்தாருக்கு, உங்களில் யார் நேராக நடக்க விரும்புகிறாரோ அவருக்கு அறிவுரை தவிர வேறு இல்லை."
    },
    {
      "ayah": 29,
      "tamil": "அகிலத்தின் இறைவனாகிய அல்லாஹ் நாடுவதைத் தவிர நீங்கள் நாடுவதில்லை."
    }
  ]
}
