{
  "surah": 96,
  "name": "அல்-அலக்",
  "source": "TNTJ",
  "verses": [
    {
      "ayah": 1,
      "tamil": "(முஹம்மதே!) படைத்த உமது இறைவனின் பெயரால் ஓதுவீராக!"
    },
    {
      "ayah": 2,
      "tamil": "அவன் மனிதனை கருவுற்ற சினை முட்டையிலிருந்து படைத்தான்."
    },
    {
      "ayah": 3,
      "tamil": "ஓதுவீராக! உமது இறைவன் கண்ணியமானவன்."
    },
    {
      "ayah": 4,
      "tamil": "அவனே எழுது கோலால் கற்றுத் தந்தான்."
    },
    {
      "ayah": 5,
      "tamil": "அறியாதவற்றை மனிதனுக்குக் கற்றுத் தந்தான்."
    },
    {
      "ayah": 6,
      "ayah_end": 7,
      "tamil": "அவ்வாறில்லை! தன்னைத் தேவையற்றவன் எனக் கருதியதால் மனிதன் வரம்பு மீறுகிறான்."
    },
    {
      "ayah": 8,
      "tamil": "உமது இறைவனிடமே திரும்பிச் செல்லுதல் உண்டு."
    },
    {
      "ayah": 9,
      "ayah_end": 10,
      "tamil": "தொழும் அடியாரைத் தடுப்பவனைப் பார்க்கவில்லையா?"
    },
    {
      "ayah": 11,
      "ayah_end": 13,
      "tamil": "அவர் நேர் வழியில் இருப்பதையே, அல்லது இறையச்சத்தை ஏவுவதையே அவன் பொய்யெனக் கருதி அலட்சியம் செய்வதை நீர் கவனித்தீரா?"
    },
    {
      "ayah": 14,
      "tamil": "அல்லாஹ் பார்க்கிறான் என்பதை அவன் அறியவில்லையா?"
    },
    {
      "ayah": 15,
      "tamil": "அவ்வாறில்லை அவன் விலகிக் கொள்ளவில்லையானால் முன் நெற்றியைப் பிடிப்போம்."
    },
    {
      "ayah": 16,
      "tamil": "அது குற்றமிழைத்த பொய் கூறிய முன் நெற்றி."
    },
    {
      "ayah": 17,
      "tamil": "அவன் தனது சபையோரை அழைக்கட்டும்."
    },
    {
      "ayah": 18,
      "tamil": "நாம் நரகின் காவலர்களை அழைப்போம்."
    },
    {
      "ayah": 19,
      "tamil": "எனவே, அவனுக்குக் கட்டுப்படா தீர்! ஸஜ்தாச் செய்வீராக! நெருங்குவீராக!"
    }
  ]
}
