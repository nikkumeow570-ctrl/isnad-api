{
  "surah": 93,
  "name": "அத்-துஹா",
  "source": "TNTJ",
  "verses": [
    {
      "ayah": 1,
      "tamil": "முற்பகல் மீது சத்தியமாக!"
    },
    {
      "ayah": 2,
      "tamil": "ஒதுங்கிச் செல்லும் இரவின் மீது சத்தியமாக!"
    },
    {
      "ayah": 3,
      "tamil": "(முஹம்மதே!) உமது இறைவன் உம்மைக் கை விடவும் இல்லை; வெறுக்கவும் இல்லை."
    },
    {
      "ayah": 4,
      "tamil": "இவ்வுலகை விட மறுமையே உமக்குச் சிறந்தது."
    },
    {
      "ayah": 5,
      "tamil": "(முஹம்மதே!) உமது இறைவன் உமக்கு வழங்குவான். நீர் திருப்தியடைவீர்."
    },
    {
      "ayah": 6,
      "tamil": "உம்மை அனாதையாகக் கண்டு அவன் அரவணைக்கவில்லையா?"
    },
    {
      "ayah": 7,
      "tamil": "உம்மை வழி அறியாதவராகக் கண்டு வழி காட்டினான்."
    },
    {
      "ayah": 8,
      "tamil": "உம்மை வறுமையில் கண்டு தன்னிறைவு பெற்றவராக்கினான்."
    },
    {
      "ayah": 9,
      "tamil": "எனவே அனாதைகளை அடக்குமுறை செய்யாதீர்!"
    },
    {
      "ayah": 10,
      "tamil": "யாசிப்பவரை விரட்டாதீர்!"
    },
    {
      "ayah": 11,
      "tamil": "உமது இறைவனின் அருட்கொடையை அறிவிப்பீராக!"
    }
  ]
}
